# The settings of every script in deploy/aws (docs/architecture/AWS_DELTA_LAKE.md). Copy this file to deploy/aws/env (git-ignored)
# and replace each <placeholder>. No secret belongs here: the scripts use the AWS credentials of the shell or the task role, and
# Drishti's own secrets live in AWS Secrets Manager (they are referenced below by name only).

# ---------------------------------------------------------------------------------------------------------- account
AWS_REGION="<eu-west-2>"
AWS_ACCOUNT_ID="<123456789012>"
ORG="<acme>"                                   # a short lower-case prefix for every name
DRISHTI_ENV="<prod>"                           # prod, uat, dev: one set of resources each
DRISHTI_VERSION=2.9.3                        # the image tags

# ---------------------------------------------------------------------------------------------------------- the lake in S3
LAKE_BUCKET=${ORG}-drishti-${DRISHTI_ENV}-lake           # the Delta tables: data files AND _delta_log
LANDING_BUCKET=${ORG}-drishti-${DRISHTI_ENV}-landing     # the sources' JSON dumps, kept LANDING_KEEP_DAYS
LOGS_BUCKET=${ORG}-drishti-${DRISHTI_ENV}-logs           # S3 server access logs
LAKE_PREFIX=lake                                         # tables at s3://LAKE_BUCKET/LAKE_PREFIX/<domain>/<table>/
LAKE_KMS_KEY_ARN="<arn:aws:kms:eu-west-2:123456789012:key/00000000-0000-0000-0000-000000000000>"
S3_VPC_ENDPOINT_ID="<vpce-0123456789abcdef0>"              # the gateway endpoint for S3; the lake allows no other network path
LAKE_TABLES_FILE=deploy/aws/delta-lake/tables.example    # which tables are loaded, from which pack and landing prefix
LANDING_KEEP_DAYS=30
NONCURRENT_KEEP_DAYS=14                                  # versions of overwritten or vacuumed objects kept (recovery window)
LOGS_KEEP_DAYS=400

# Storage tiers by BUSINESS DATE (setup-lifecycle.sh): a day's data files move when the day is this old, whatever their write time
TIER_IA_AFTER_DAYS=90                                    # S3 Standard -> Standard-IA
TIER_GLACIER_IR_AFTER_DAYS=730                           # Standard-IA -> Glacier Instant Retrieval (milliseconds; never Flexible or Deep Archive)
LAKE_FIRST_YEAR=2019                                     # the oldest business year in the lake

# ---------------------------------------------------------------------------------------------------------- loading and maintenance
LAKE_WORK_DIR=/opt/drishti/data/lake-build               # the loader's scratch lakes (EFS on ECS; one per run, removed after it)
LAKE_LOCK_DIR=/opt/drishti/data/lake-locks               # one lock per table: a load, a backfill and maintenance never overlap
LAKE_BATCH_ROWS=250000                                   # lake build sorts a partition by id when it fits one batch (memory ~ rows x document size x 3)
LAKE_ROW_GROUP_KB=1024                                   # Parquet row groups (DRISHTI_LAKE_ROW_GROUP_KB): one single read decodes one
LAKE_KEEP_BUSINESS_DAYS=1800                             # retention, counted back from today (about seven years)
LAKE_VACUUM_HOURS=168                                    # removed files kept a week: "known at" and readers in flight reach back that far
DRISHTI_SIGNAL_URL=                                      # optional: http://drishti-a.drishti.local:18480 to send the data-load signal
DRISHTI_TOKEN_SECRET_ID=                                 # optional: the Secrets Manager id of an API token with loads:write, for the signal
PACK_NAME_FOR_SIGNAL=trading

# ---------------------------------------------------------------------------------------------------------- ECS, EFS, Cloud Map
ECS_CLUSTER=drishti-${DRISHTI_ENV}
DRISHTI_NODES="drishti-a drishti-b drishti-c"            # one ECS service per node; each has its own EFS folders
DRISHTI_NET_SEED_NODES="drishti-a drishti-b"             # the seeds new members join through (Cloud Map names)
EFS_FILE_SYSTEM_ID="<fs-0123456789abcdef0>"
VPC_ID="<vpc-0123456789abcdef0>"
PRIVATE_SUBNETS="<subnet-aaaa,subnet-bbbb,subnet-cccc>"
NODE_SECURITY_GROUP="<sg-0123456789abcdef0>"
CONSOLE_TARGET_GROUP_ARN="<arn:aws:elasticloadbalancing:eu-west-2:123456789012:targetgroup/drishti-consoles/0123456789abcdef>"
CLOUD_MAP_NAMESPACE=drishti.local
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com
DRISHTI_PACKS=core,market-data,trading,counterparty-risk,market-risk
SERVER_CPU=4096
SERVER_MEMORY=12288
SERVER_HEAP=8g
TASK_CPU=6144
TASK_MEMORY=16384
LOADER_CPU=4096
LOADER_MEMORY=30720
LOAD_SCHEDULE="cron(30 22 ? * MON-FRI *)"                # EventBridge Scheduler, in LOAD_SCHEDULE_ZONE: after the dumps land
MAINTAIN_SCHEDULE="cron(30 2 ? * TUE-SAT *)"
REPORT_SCHEDULE="cron(0 7 ? * * *)"
LOAD_SCHEDULE_ZONE=America/New_York

# Secrets Manager ids (the values never appear in a file, a task definition or EFS)
SECRET_TOKEN=drishti/${DRISHTI_ENV}/token
SECRET_SESSION=drishti/${DRISHTI_ENV}/session
SECRET_NET=drishti/${DRISHTI_ENV}/net
SECRET_ADMIN=drishti/${DRISHTI_ENV}/admin

# ---------------------------------------------------------------------------------------------------------- alarms
ALARM_SNS_TOPIC_ARN="<arn:aws:sns:eu-west-2:123456789012:drishti-alarms>"
ALARM_PUBLISH_DEADLINE_HOURS=4                           # the newest business day must be published within this after the load starts
ALARM_COMMITS_SINCE_CHECKPOINT=50                        # a table whose readers replay more commits than this is slow to open
ALARM_S3_5XX_PER_5MIN=50

# ---------------------------------------------------------------------------------------------------------- Iceberg (deploy/aws/iceberg)
# Delta Lake is the default lake format; these are read only by deploy/aws/iceberg/*.sh, when a deployment chooses Iceberg.
ICEBERG_PREFIX=iceberg                                   # tables at s3://LAKE_BUCKET/ICEBERG_PREFIX/<domain>/<table>/ (data/ and metadata/)
ICEBERG_CATALOG=hadoop                                   # hadoop: path-based tables in S3; glue: the AWS Glue Iceberg REST catalog (the domain is the Glue database)
GLUE_CATALOG_ID=${AWS_ACCOUNT_ID}                        # ICEBERG_CATALOG=glue: the Glue catalog (the account id)
ICEBERG_TABLES_FILE=deploy/aws/iceberg/tables.example    # which tables are loaded into Iceberg, from which pack and landing prefix
ICEBERG_KEEP_BUSINESS_DAYS=1800                          # retention (the risk and risk-results domains keep 7 years whatever is set)
ICEBERG_EXPIRE_HOURS=168                                 # snapshots older than this are expired ("known at" reaches back that far)
ICEBERG_ORPHAN_HOURS=72                                  # files no snapshot references, older than this, are removed (72 at least)
