{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ListTheLake", "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::${LAKE_BUCKET}" },
    { "Sid": "CheckpointRetentionVacuum", "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::${LAKE_BUCKET}/${LAKE_PREFIX}/*" },
    { "Sid": "EncryptAndDecrypt", "Effect": "Allow", "Action": ["kms:Decrypt", "kms:Encrypt", "kms:GenerateDataKey"],
      "Resource": "${LAKE_KMS_KEY_ARN}" },
    { "Sid": "StorageTierRules", "Effect": "Allow", "Action": ["s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration"],
      "Resource": "arn:aws:s3:::${LAKE_BUCKET}" },
    { "Sid": "ReportMetrics", "Effect": "Allow", "Action": ["cloudwatch:PutMetricData", "cloudwatch:GetMetricStatistics"], "Resource": "*" },
    { "Sid": "MountTheMaintenanceFolder", "Effect": "Allow", "Action": ["elasticfilesystem:ClientMount", "elasticfilesystem:ClientWrite"],
      "Resource": "arn:aws:elasticfilesystem:${AWS_REGION}:${AWS_ACCOUNT_ID}:file-system/${EFS_FILE_SYSTEM_ID}" }
  ]
}
