# The JVM options of the server images (deploy/docker/server.Dockerfile, ecs/server.Dockerfile): /opt/drishti/lib/server.args
# Written by python tools/drishti.py launchers; generated from serverstart.jvm_flags and committed: never edit it.
"-Djava.io.tmpdir=/opt/drishti/data/tmp/server"
"-XX:MaxRAMPercentage=75"
"-XX:+UseZGC"
"-XX:MaxDirectMemorySize=256m"
"-XX:TrimNativeHeapInterval=60000"
"-Djdk.nio.maxCachedBufferSize=262144"
"-XX:NativeMemoryTracking=summary"
"-XX:+HeapDumpOnOutOfMemoryError"
"-XX:HeapDumpPath=/opt/drishti/data/dumps/server"
"-Xlog:gc*:file=\"/opt/drishti/data/logs/gc-server-%p.log\":time,uptime:filecount=5,filesize=20m"
