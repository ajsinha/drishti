# The Drishti server as a systemd service (docs/admin/OPERATIONS.md section 7.2). Copy to /etc/systemd/system/drishti-server.service,
# and deploy/bin/drishti-node.sh to /opt/drishti/bin/. The stop drains the node first (CD2, CLUSTER_DEPLOYMENT.md section 4.6):
# forwarded work and VaR shards go to other members, then SIGTERM runs Spring's graceful shutdown. The drain needs DRISHTI_DRAIN_TOKEN in
# the environment file (an administrator's personal API token with the node:drain scope); without it the stop goes on undrained.
[Unit]
Description=Drishti server
After=network-online.target
Wants=network-online.target

[Service]
User=drishti
WorkingDirectory=/opt/drishti
EnvironmentFile=/etc/drishti/drishti.env
Environment=JAVA_TOOL_OPTIONS=-Xmx4g -XX:+UseZGC -XX:+ZGenerational -XX:MaxDirectMemorySize=256m -XX:TrimNativeHeapInterval=60000 -Djdk.nio.maxCachedBufferSize=262144 -XX:NativeMemoryTracking=summary -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/opt/drishti/data/dumps
Environment=MALLOC_ARENA_MAX=2
Environment=DRISHTI_DRAIN_WAIT=240
ExecStartPre=/usr/bin/mkdir -p /opt/drishti/data/logs /opt/drishti/data/dumps
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java -Djava.io.tmpdir=/opt/drishti/data/tmp/server -Xlog:gc*:file=/opt/drishti/data/logs/gc-%p.log:time,uptime:filecount=5,filesize=20m -jar /opt/drishti/drishti-server.jar
# the stop hook: drain, wait for safeToStop (at most DRISHTI_DRAIN_WAIT); systemd then sends SIGTERM. The leading '-' lets the stop go on
# when the drain is refused or not safe in time
ExecStop=-/opt/drishti/bin/drishti-node.sh drain
SuccessExitStatus=143
# the drain (240 s) plus Spring's graceful shutdown (30 s) plus a margin
TimeoutStopSec=300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
