# The Drishti server as a systemd service (docs/guides/OPERATIONS_GUIDE.md section 5.3). Copy to /etc/systemd/system/drishti-server.service,
# and deploy/jvm/server-service.args (the JVM options, generated from the function drishti.py start server runs) to /opt/drishti/lib/server.args.
# The stop drains the node first: on SIGTERM the server drains itself (CD2, drishti.node.drain.on-stop: forwarded work and VaR shards go
# to other members, at most DRISHTI_DRAIN_WAIT), then Spring's graceful shutdown.
[Unit]
Description=Drishti server
After=network-online.target
Wants=network-online.target

[Service]
User=drishti
WorkingDirectory=/opt/drishti
EnvironmentFile=/etc/drishti/drishti.env
Environment=MALLOC_ARENA_MAX=2
# the launch roots, absolute (docs/admin/CONFIGURATION.md, "Launch roots"): the install folder, the data folder and the modules;
# the others sit under them unless /etc/drishti/drishti.env names them
Environment=DRISHTI_HOME=/opt/drishti
Environment=DRISHTI_DATA_DIR=/opt/drishti/data
# the packages (*.dmod) and first-party.yaml: modules are packages beside the server jar in /opt/drishti/lib
Environment=DRISHTI_MODULES_HOME=/opt/drishti/modules
Environment=DRISHTI_DRAIN_WAIT=240
ExecStartPre=/usr/bin/mkdir -p /opt/drishti/data/logs /opt/drishti/data/dumps/server /opt/drishti/data/tmp/server
# the one server jar of the install, <home>/lib (whatever its version: the shell expands the name); the GC log, heap dumps and temp folder are in server.args
# Java 21+: java on the PATH, or name your JDK's bin/java here; -XX:+ZGenerational on Java 21 (the default from 23)
ExecStart=/bin/sh -c 'exec java @/opt/drishti/lib/server.args -XX:+ZGenerational -jar /opt/drishti/lib/drishti-server-*-exec.jar'
SuccessExitStatus=143
# the drain (240 s) plus Spring's graceful shutdown (30 s) plus a margin
TimeoutStopSec=300
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
