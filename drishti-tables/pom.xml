<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.a</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-tables</artifactId>
  <name>drishti-tables</name>
  <description>The table layer (docs/architecture/VIRTUAL_TABLES.md, BI_FOUNDATION_2911E.md sections 3 to 5): plain Java, no Spring. The
    catalogue of virtual tables and models (config/tables/&lt;domain&gt;/&lt;name&gt;.table.yaml and .model.yaml, and stored items of the
    kinds table and model), their definitions and checks, preview over sample documents, lineage (who uses a table), the
    materialisation's API (on-load, live, none) and the migration of BI's datasets and models into tables and layer models.
    Depends on Rachana (paths and expressions) and the pivot engine (the function catalogue); BI depends on this module, never the
    reverse (ArchitectureRulesTest).</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <dependency>
      <groupId>com.ash.drishti</groupId><artifactId>drishti-rachana</artifactId>
      <exclusions>
        <exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId></exclusion>
        <exclusion><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-bicompute</artifactId></dependency>
    <!-- Rachana's expression cache is Caffeine; a compile from the checks needs it at run time -->
    <dependency><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
