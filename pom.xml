  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <forkCount>${drishti.test.forks}</forkCount>
          <reuseForks>true</reuseForks>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-java</id>
            <goals><goal>enforce</goal></goals>
            <configuration><rules><requireJavaVersion><version>[21,)</version><message>Drishti needs Java 21 or newer (any vendor; production runs Java 21). Maven is running on Java ${java.specification.version} from ${java.home}: set JAVA_HOME to a JDK 21 or newer and check with ./mvnw -v.</message></requireJavaVersion></rules></configuration>
          </execution>
          <!-- production runs on Java 21: no class file in the product, ours or a library's, may need a newer JVM.
               the compiler release setting (21) covers our code; this covers every runtime dependency, so `mvn package` fails instead of
               producing a jar that stops on Java 21 with UnsupportedClassVersionError. -->
          <execution>
            <id>enforce-bytecode-21</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <enforceBytecodeVersion>
                  <maxJdkVersion>21</maxJdkVersion>
                  <ignoredScopes><ignoredScope>test</ignoredScope></ignoredScopes>
                  <message>A dependency needs a JVM newer than Java 21, which production runs. Pin an older version of it.</message>
                </enforceBytecodeVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency><groupId>org.codehaus.mojo</groupId><artifactId>extra-enforcer-rules</artifactId><version>1.10.0</version></dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <parameters>true</parameters>
          <!-- Error Prone (ADR-007): checks that find real bugs fail the build; style-level checks stay warnings -->
          <compilerArgs>
            <arg>-Xlint:all,-processing,-serial</arg>
            <arg>-XDcompilePolicy=simple</arg>
            <arg>--should-stop=ifError=FLOW</arg>
            <arg>-Xplugin:ErrorProne -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/target/.* -Xep:NonAtomicVolatileUpdate:ERROR -Xep:LockNotBeforeTry:ERROR -Xep:JavaTimeDefaultTimeZone:ERROR</arg>
          </compilerArgs>
          <annotationProcessorPaths>
            <path><groupId>com.google.errorprone</groupId><artifactId>error_prone_core</artifactId><version>${errorprone.version}</version></path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Spotless (ADR-007): what .editorconfig promises, checked at verify: no trailing whitespace, a final newline,
           spaces not tabs, no unused imports. A full reformatter is not used: it would rewrite the code base's style. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes><include>src/**/*.java</include></includes>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
            <indent><spaces>true</spaces><spacesPerTab>4</spacesPerTab></indent>
          </java>
        </configuration>
        <executions>
          <execution><goals><goal>check</goal></goals><phase>verify</phase></execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
