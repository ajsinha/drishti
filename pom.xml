    <archunit.version>1.5.0</archunit.version>
    <errorprone.version>2.36.0</errorprone.version>
    <spotless.version>3.10.2</spotless.version>
    <jmh.version>1.37</jmh.version>
    <springdoc.version>2.9.1</springdoc.version>
    <delta-kernel.version>4.4.0</delta-kernel.version>
    <hadoop.version>3.4.3</hadoop.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <greenmail.version>2.1.5</greenmail.version>
    <activemq.version>6.3.2</activemq.version>
    <rabbitmq.version>5.36.0</rabbitmq.version>
    <awssdk.version>2.55.9</awssdk.version>
    <rocksdb.version>11.0.4</rocksdb.version>
    <aerospike.version>10.5.0</aerospike.version>
    <lettuce.version>6.8.2.RELEASE</lettuce.version>
    <zstd-jni.version>1.5.7-6</zstd-jni.version>
    <!-- 1.10.x reads and writes Parquet 1.16, the version Delta Kernel uses: one Parquet on the server's classpath -->
    <iceberg.version>1.10.1</iceberg.version>
    <parquet.version>1.17.1</parquet.version>
    <!-- the Snappy that hadoop-client-api brings: Parquet pages written by delta-rs are Snappy by default -->
    <snappy-java.version>1.1.10.4</snappy-java.version>
    <!-- LZ4 Parquet pages (delta-rs and Arrow write them): the maintained lz4-java fork, safe pure-Java and JNI decoders -->
    <lz4-java.version>1.10.2</lz4-java.version>
    <duckdb.version>1.5.6.0</duckdb.version>
    <!-- test classes run in this many parallel JVM forks per module (each fork reused for many classes); -Ddrishti.test.forks=1
         runs them serially. Fixed scratch paths in a module's surefire configuration carry ${surefire.forkNumber} -->
    <drishti.test.forks>4</drishti.test.forks>
  </properties>

