<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- deliberately not a child of drishti-parent: the parent gives every module this one as a test dependency, so a child would be its own dependency -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>com.ash.drishti</groupId>
  <artifactId>drishti-testroots</artifactId>
  <version>${revision}</version>
  <name>drishti-testroots</name>
  <description>Where a test finds the repository and its module, from its own code location, never the working folder</description>
  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- standalone: the same Lake pin as the root pom.xml's drishti.lake.version (hold them equal when the pin moves) -->
    <drishti.lake.version>0.9.2</drishti.lake.version>
  </properties>
  <dependencies>
    <!-- G4 rehearsal: the pinned Drishti Lake jars -->
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-tck</artifactId><version>${drishti.lake.version}</version></dependency>
  </dependencies>
  <!-- standalone (Spring Boot's parent, not drishti-parent): the same Spotless check as every module (ADR-007), so the gate's
       `spotless:check` finds the plugin here too -->
  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <java>
            <includes><include>src/**/*.java</include></includes>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
            <indent><spaces>true</spaces><spacesPerTab>4</spacesPerTab></indent>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
