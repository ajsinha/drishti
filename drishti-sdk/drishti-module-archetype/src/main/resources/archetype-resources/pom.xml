<?xml version="1.0" encoding="UTF-8"?>
<!-- A Drishti module, made by drishti-module-archetype, in the one module layout: its .dmod content at the top (module.yaml, packs/,
     console/, data/, docs/) and its code as Maven projects under java/. This pom only aggregates them: `mvn verify` here builds
     java/${artifactId}, packs java/${artifactId}/target/dmod/${artifactId}-${version}.dmod from this folder and runs the conformance
     checks C1-C15 (docs/guides/DEVELOPER_GUIDE.md, the Module SDK). -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>${groupId}</groupId>
  <artifactId>${artifactId}-module</artifactId>
  <version>${version}</version>
  <packaging>pom</packaging>
  <name>${artifactId}-module</name>
  <modules>
    <module>java/${artifactId}</module>
  </modules>
</project>
