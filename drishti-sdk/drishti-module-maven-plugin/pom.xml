<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-module-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>drishti-module-maven-plugin</name>
  <description>The Module SDK's Maven plugin (docs/architecture/KERNEL_AND_MODULES.md section 8.2): drishti:validate (the manifest against
    the pom), drishti:assemble (packs target/dmod/ID-VERSION.dmod with the module runtime's packer and its hash list) and
    drishti:conformance (the fifteen conformance checks C1-C15 of section 8.6, with plain-words failures; C11 and C13-C15 load the module
    into the module runtime). A thin wrapper: the packer and the checks are drishti-module-runtime's (com.ash.drishti.module.tool), the same code as the
    standalone tool (java -jar drishti-module-tool.jar).</description>
  <properties>
    <maven-plugin-tools.version>3.15.1</maven-plugin-tools.version>
    <maven-api.version>3.9.12</maven-api.version>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-module-runtime</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-kernel-api</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
    <!-- the kernel supplies Spring Web to every module (its @ModuleApi controllers, ResponseEntity): the C11-C15 runtime has it too -->
    <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId></dependency>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-plugin-api</artifactId><version>${maven-api.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven</groupId><artifactId>maven-core</artifactId><version>${maven-api.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.apache.maven.plugin-tools</groupId><artifactId>maven-plugin-annotations</artifactId><version>${maven-plugin-tools.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <version>${maven-plugin-tools.version}</version>
        <configuration><goalPrefix>drishti</goalPrefix></configuration>
      </plugin>
    </plugins>
  </build>
</project>
