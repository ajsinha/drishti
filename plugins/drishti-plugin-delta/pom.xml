<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-plugin-delta</artifactId>
  <name>drishti-plugin-delta</name>
  <description>Delta Lake source: dated entity tables read with Delta Kernel (no Spark), with time travel</description>
  <dependencies>
    <!-- Drishti Lake: the Delta table layer, read through its public read API (com.ash.lake.read) -->
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-delta</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers</artifactId><version>${testcontainers.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><version>${testcontainers.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId></dependency>
    <dependency><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>   <!-- ReferenceScanner -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
    <!-- the loader writes the tests' tables; the product's test roots and the TLS and proxy fixtures -->
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-load</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-files</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-testkit</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lake-host</artifactId></dependency>
    <!-- S3Mock in the test JVM (no Docker): the Delta Lake on S3 connector's test, DeltaOnAwsS3Test -->
    <dependency><groupId>com.adobe.testing</groupId><artifactId>s3mock</artifactId><version>${s3mock.version}</version><scope>test</scope></dependency>
  </dependencies>
</project>
