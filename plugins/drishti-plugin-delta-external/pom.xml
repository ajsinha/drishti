    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
    <!-- the Spark-shaped Delta table and the mock Unity Catalog and Delta Sharing servers -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakehouse</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
