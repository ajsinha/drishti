<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-app</artifactId>
  <name>drishti-app</name>
  <description>The runnable server (docs/architecture/DOMAIN_MODULES.md): the core (drishti-server) with the domain modules this build ships
    (drishti-banking), as one executable jar. It holds no code. The jar keeps its path, drishti-server/target/drishti-server-VERSION-exec.jar,
    so every launcher, script and guide is unchanged; the thin jar with a plugins folder (each site's modules beside it) comes later</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-server</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-banking</artifactId></dependency>
  </dependencies>
  <build>
    <!-- named as the server's jar always was, and written beside it (drishti-server/target), so nothing that starts the server changes -->
    <finalName>drishti-server-${project.version}</finalName>
    <plugins>
      <!-- the executable jar's manifest grants native access (RocksDB, SQLite, DuckDB, Hadoop load native libraries):
           JDK 25 warns without it and a future JDK blocks it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><archive><manifestEntries><Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access><Add-Opens>java.base/java.nio</Add-Opens></manifestEntries></archive></configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>com.ash.drishti.server.DrishtiApplication</mainClass>
          <layout>ZIP</layout>
          <outputDirectory>${project.basedir}/../drishti-server/target</outputDirectory>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
