          "command": "python3 tools/drishti.py setup --check"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: build demo lakes",
        "type": "shell",
        "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake demo --engine java",
        "windows": {
          "command": "py -3.13 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake demo --engine java"
        },
        "linux": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake demo --engine java"
        },
        "osx": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake demo --engine java"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: run loader (file into the lake)",
        "type": "shell",
        "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake build --from \"${input:file}\" --kind trade --mode overwrite-dates --lake demo",
        "windows": {
          "command": "py -3.13 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake build --from \"${input:file}\" --kind trade --mode overwrite-dates --lake demo"
        },
        "linux": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake build --from \"${input:file}\" --kind trade --mode overwrite-dates --lake demo"
        },
        "osx": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" lake build --from \"${input:file}\" --kind trade --mode overwrite-dates --lake demo"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: check acceptance",
        "type": "shell",
        "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor --acceptance",
        "windows": {
          "command": "py -3.13 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor --acceptance"
        },
        "linux": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor --acceptance"
        },
        "osx": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor --acceptance"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: check environment",
        "type": "shell",
        "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor",
        "windows": {
          "command": "py -3.13 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor"
        },
        "linux": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor"
        },
        "osx": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo doctor"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: check environment (QA)",
        "type": "shell",
        "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa doctor",
        "windows": {
          "command": "py -3.13 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa doctor"
        },
        "linux": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa doctor"
        },
        "osx": {
          "command": "python3 tools/drishti.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa doctor"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "file",
        "type": "promptString",
        "description": "The file of yours to load into the demo lake"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Drishti: run console",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/drishti-console/run_drishti_web.py",
        "args": [
          "--settings",
          "${userHome}/drishti-envs/dev.ini",
          "--profile",
          "demo"
        ]
      },
      {
        "name": "Drishti: run console (QA, port 17580)",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/drishti-console/run_drishti_web.py",
        "args": [
          "--settings",
          "${userHome}/drishti-envs/dev.ini",
          "--profile",
          "qa"
        ]
      },
      {
        "name": "Drishti: run console (Risk)",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/drishti-console/run_drishti_web.py",
        "args": [
          "--settings",
          "${userHome}/drishti-envs/dev.ini",
          "--profile",
          "demo",
          "--distribution=risk"
        ]
      },
      {
        "name": "Drishti: run console (Finance)",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/drishti-console/run_drishti_web.py",
        "args": [
          "--settings",
          "${userHome}/drishti-envs/dev.ini",
          "--profile",
          "demo",
          "--distribution=finance",
          "--server.port=17481"
        ]
      },
      {
        "name": "Drishti: setup",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/tools/drishti.py",
        "args": [
          "setup"
        ]
      },
      {
        "name": "Drishti: setup (package index)",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
