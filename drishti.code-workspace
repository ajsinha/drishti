        "windows": {
          "command": "py -3.13 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=risk"
        },
        "linux": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=risk"
        },
        "osx": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=risk"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: run console (Finance)",
        "type": "shell",
        "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=finance --server.port=17481",
        "windows": {
          "command": "py -3.13 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=finance --server.port=17481"
        },
        "linux": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=finance --server.port=17481"
        },
        "osx": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo --distribution=finance --server.port=17481"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: setup",
        "type": "shell",
        "command": "python3 tools/drishti.py setup",
