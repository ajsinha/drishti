        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/tools/drishti.py",
        "args": [
          "--settings",
          "${userHome}/drishti-envs/dev.ini",
          "lake",
          "demo",
          "--engine",
          "java"
        ]
      },
      {
        "name": "Drishti: run loader (file into the lake)",
        "type": "debugpy",
        "request": "launch",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "program": "${workspaceFolder}/tools/drishti.py",
        "args": [
          "--settings",
          "${userHome}/drishti-envs/dev.ini",
          "lake",
          "build",
          "--from",
          "${input:file}",
          "--kind",
          "trade",
