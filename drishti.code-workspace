//
// Drishti in VS Code: File, Open Workspace from File. The tasks and launch configurations carry the SAME names as the JetBrains run
// configurations in .idea/runConfigurations/ (the launcher standard: docs/plans/LAUNCHER_STANDARD.md). Generated from tools/launch/launchers.yaml by
// python tools/drishti.py launchers: never edit this file, edit the table. Paths use ${userHome}; Python is py -3.13 on Windows and
// python3 elsewhere; Java is the JDK 21 of JAVA_HOME (no machine path here).
// Build and run in the IDE: README.md#build-and-run-in-the-ide.
{
  "folders": [
    {
      "name": "drishti",
      "path": "."
    }
  ],
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy",
      "vscjava.vscode-java-pack",
      "redhat.vscode-yaml"
    ]
  },
  "settings": {
    "files.exclude": {
      "**/__pycache__": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Drishti: build all",
        "type": "shell",
        "command": "./mvnw clean package -DskipTests -pl :drishti-app,:drishti-modules -am",
        "windows": {
          "command": "mvnw.cmd clean package -DskipTests -pl :drishti-app,:drishti-modules -am"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Drishti: test",
        "type": "shell",
        "command": "./mvnw clean verify",
        "windows": {
          "command": "mvnw.cmd clean verify"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": "Drishti: build modules",
        "type": "shell",
        "command": "./mvnw clean package -DskipTests -pl :drishti-modules -am -Pmodules-only",
        "windows": {
          "command": "mvnw.cmd clean package -DskipTests -pl :drishti-modules -am -Pmodules-only"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "Drishti: run server (demo)",
        "type": "shell",
        "command": "python3 tools/drishti.py start server --profile demo",
        "windows": {
          "command": "py -3.13 tools/drishti.py start server --profile demo"
        },
        "linux": {
          "command": "python3 tools/drishti.py start server --profile demo"
        },
        "osx": {
          "command": "python3 tools/drishti.py start server --profile demo"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: run server (built-in samples)",
        "type": "shell",
        "command": "python3 tools/drishti.py start server --profile samples",
        "windows": {
          "command": "py -3.13 tools/drishti.py start server --profile samples"
        },
        "linux": {
          "command": "python3 tools/drishti.py start server --profile samples"
        },
        "osx": {
          "command": "python3 tools/drishti.py start server --profile samples"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: run server (QA, port 18580)",
        "type": "shell",
        "command": "python3 tools/drishti.py start server --profile qa",
        "windows": {
          "command": "py -3.13 tools/drishti.py start server --profile qa"
        },
        "linux": {
          "command": "python3 tools/drishti.py start server --profile qa"
        },
        "osx": {
          "command": "python3 tools/drishti.py start server --profile qa"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: run console",
        "type": "shell",
        "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo",
        "windows": {
          "command": "py -3.13 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo"
        },
        "linux": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo"
        },
        "osx": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile demo"
        },
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: run console (QA, port 17580)",
        "type": "shell",
        "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa",
        "windows": {
          "command": "py -3.13 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa"
        },
        "linux": {
          "command": "python3 drishti-console/run_drishti_web.py --settings \"${userHome}/drishti-envs/dev.ini\" --profile qa"
        },
        "osx": {
