        },
        "problemMatcher": []
      },
      {
        "label": "Drishti: setup (package index)",
        "type": "shell",
        "command": "python3 tools/drishti.py setup --index",
        "windows": {
          "command": "py -3.13 tools/drishti.py setup --index"
        },
        "linux": {
          "command": "python3 tools/drishti.py setup --index"
