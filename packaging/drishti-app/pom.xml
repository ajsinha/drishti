<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-app</artifactId>
  <name>drishti-app</name>
  <description>The runnable server: the kernel (drishti-server) as one executable jar. It holds no code and no module: the modules are packages
    (.dmod) beside the jar, built by packaging/dist (docs/architecture/KERNEL_AND_MODULES.md). The jar keeps its path,
    kernel/drishti-server/target/drishti-server-VERSION-exec.jar, and at package is installed into the lib folder (drishti.home.lib, default
    the repository's lib/), unless -Ddrishti.install.skip=true (the properties are the parent pom's)</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-server</artifactId></dependency>
  </dependencies>
  <build>
    <!-- named as the server's jar always was, and written beside it (kernel/drishti-server/target), so nothing that starts the server changes -->
    <finalName>drishti-server-${project.version}</finalName>
    <plugins>
      <!-- the executable jar's manifest grants native access (RocksDB, SQLite, DuckDB, Hadoop load native libraries):
           JDK 25 warns without it and a future JDK blocks it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><archive><manifestEntries><Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access><Add-Opens>java.base/java.nio</Add-Opens></manifestEntries></archive></configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>com.ash.drishti.server.DrishtiApplication</mainClass>
          <layout>ZIP</layout>
          <outputDirectory>${project.basedir}/../../kernel/drishti-server/target</outputDirectory>
        </configuration>
      </plugin>
      <!-- META-INF/drishti/kernel-libraries.txt (KERNEL_AND_MODULES.md section 4.4): every jar the server jar holds in BOOT-INF/lib, as
           group:artifact:version, its name and its package prefixes. The kernel's libraries always win in a module's class loader; the
           list names a module's own copy of one (a warning at load and in `module verify`). Generated from the runtime dependencies (the
           jars the repackaging puts in BOOT-INF/lib), then checked against BOOT-INF/lib of the repackaged jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>kernel-libraries-list</id>
            <phase>generate-resources</phase>
            <goals><goal>list</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputAbsoluteArtifactFilename>true</outputAbsoluteArtifactFilename>
              <outputFile>${project.build.directory}/kernel-libraries.list</outputFile>
              <silent>true</silent>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>kernel-libraries</id>
            <phase>generate-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>com.ash.drishti.module.runtime.KernelLibraries</mainClass>
              <arguments>
                <argument>generate</argument>
                <argument>${project.build.directory}/kernel-libraries.list</argument>
                <argument>${project.build.outputDirectory}/META-INF/drishti/kernel-libraries.txt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- after the repackaging (declared after spring-boot-maven-plugin, same phase) -->
            <id>kernel-libraries-check</id>
            <phase>package</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <!-- no exec jar to check when none is made (the profile modules-only) -->
              <skip>${spring-boot.repackage.skip}</skip>
              <mainClass>com.ash.drishti.module.runtime.KernelLibraries</mainClass>
              <arguments>
                <argument>check</argument>
                <argument>${project.basedir}/../../kernel/drishti-server/target/drishti-server-${project.version}-exec.jar</argument>
                <argument>${project.build.outputDirectory}/META-INF/drishti/kernel-libraries.txt</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- the install (on by default; -Ddrishti.install.skip=true, or drishti.install.jar.skip, leaves it in kernel/drishti-server/target):
                 the exec jar into the install's lib folder through a .part file and one replace, any other server jar there removed (lib/ext untouched) -->
            <id>install-jar</id>
            <phase>package</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${drishti.install.jar.skip}</skip>
              <mainClass>com.ash.drishti.server.cli.ModuleCli</mainClass>
              <blockSystemExit>true</blockSystemExit>
              <arguments>
                <argument>module</argument><argument>install-jar</argument>
                <argument>${project.basedir}/../../kernel/drishti-server/target/drishti-server-${project.version}-exec.jar</argument>
                <argument>--into</argument><argument>${drishti.home.lib}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
