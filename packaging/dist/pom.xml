<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-modules</artifactId>
  <packaging>pom</packaging>
  <name>drishti-modules</name>
  <description>The product's first-party modules as packages (docs/architecture/KERNEL_AND_MODULES.md section 3.3, KERNEL_AND_MODULES.md): all twelve
    modules (banking with its code and its kernel-internals allowance, stamped with the kernel build of this build; market-data, trading and
    genomics with their jars; external-data, news-and-events and the six source-system modules from their folders), each packed by the one packer
    (ModuleCli module pack, Java) into target/dmod/ID-VERSION.dmod, and first-party.yaml (their ids and hash-list hashes).
    Banking, market-data, trading and genomics (the modules with a server part) go through the fourteen conformance checks (ModuleCli verify) as part of the build.
    Nothing here goes into the server jar: at package the packages are installed into the modules folder (drishti.home.modules, default
    the repository's modules/), unless -Ddrishti.install.skip=true (the properties are the parent pom's).
    Each is stamped for the kernel build of drishti.kernel.jar: the exec jar of this reactor by default, the jar in lib/ with -Pmodules-only.</description>
  <properties>
    <drishti.dmods>${project.build.directory}/dmod</drishti.dmods>
    <drishti.jars>${project.build.directory}/module-jars</drishti.jars>
    <drishti.repo>${project.basedir}/../..</drishti.repo>
    <skipTests>false</skipTests>
  </properties>
  <dependencies>
    <!-- the kernel on the tool's class path: its build (META-INF/build-info.properties) is the one banking is stamped for -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-server</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-module-runtime</artifactId></dependency>
    <!-- build order only (the exec jar the packages are stamped for exists first); nothing of it is used -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-app</artifactId><version>${project.version}</version><type>pom</type><scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
    <!-- banking's jars go into its package, never on the kernel's class path -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-banking</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-compute-banking</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-trading</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-market-data</artifactId><version>${project.version}</version><scope>provided</scope></dependency>
    <!-- the genomics sample ships with the product too (its server part: the showcase API its pages call) -->
    <dependency><groupId>org.helixlab</groupId><artifactId>genomics</artifactId><version>0.1.0</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>banking-jars</id>
            <phase>process-classes</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${drishti.jars}</outputDirectory>
              <stripVersion>true</stripVersion>
              <artifactItems>
                <artifactItem><groupId>com.ash.drishti</groupId><artifactId>drishti-banking</artifactId><version>${project.version}</version></artifactItem>
                <artifactItem><groupId>com.ash.drishti</groupId><artifactId>drishti-compute-banking</artifactId><version>${project.version}</version></artifactItem>
                <artifactItem><groupId>com.ash.drishti</groupId><artifactId>drishti-trading</artifactId><version>${project.version}</version></artifactItem>
                <artifactItem><groupId>com.ash.drishti</groupId><artifactId>drishti-market-data</artifactId><version>${project.version}</version></artifactItem>
                <artifactItem><groupId>org.helixlab</groupId><artifactId>genomics</artifactId><version>0.1.0</version></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- the one packer and the verifier, both ModuleCli of the server classes on this class path (module pack, first-party, verify, install) -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>pack-banking</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/banking</argument><argument>--jar</argument><argument>${drishti.jars}/drishti-banking.jar</argument><argument>--jar</argument><argument>${drishti.jars}/drishti-compute-banking.jar</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-market-data</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/market-data</argument><argument>--jar</argument><argument>${drishti.jars}/drishti-market-data.jar</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-trading</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/trading</argument><argument>--jar</argument><argument>${drishti.jars}/drishti-trading.jar</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-genomics</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/genomics</argument><argument>--jar</argument><argument>${drishti.jars}/genomics.jar</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-external-data</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/external-data</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-news-and-events</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/news-and-events</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-reference-data</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/reference-data</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-source-calypso</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/source-calypso</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-source-endur</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/source-endur</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-source-ici</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/source-ici</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-source-murex</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/source-murex</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-source-swapone</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/source-swapone</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-source-wss</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>pack</argument><argument>${drishti.repo}/modules/source-wss</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument><argument>--kernel-jar</argument><argument>${drishti.kernel.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>first-party</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>module</argument><argument>first-party</argument><argument>${drishti.dmods}</argument>
                <argument>--out</argument><argument>${drishti.dmods}/first-party.yaml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- the fourteen conformance checks, against this build's kernel (the class path) and first-party list (the one just written) -->
            <id>check-banking</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <arguments>
                <argument>module</argument><argument>verify</argument><argument>${drishti.dmods}/banking-1.0.0.dmod</argument><argument>--conformance</argument>
                <argument>--first-party</argument><argument>${drishti.dmods}/first-party.yaml</argument>
                <argument>--with</argument><argument>${drishti.dmods}/market-data-1.0.0.dmod</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>check-market-data</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <arguments>
                <argument>module</argument><argument>verify</argument><argument>${drishti.dmods}/market-data-1.0.0.dmod</argument><argument>--conformance</argument>
                <argument>--first-party</argument><argument>${drishti.dmods}/first-party.yaml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>check-trading</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <arguments>
                <argument>module</argument><argument>verify</argument><argument>${drishti.dmods}/trading-1.0.0.dmod</argument><argument>--conformance</argument>
                <argument>--first-party</argument><argument>${drishti.dmods}/first-party.yaml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>check-genomics</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <arguments>
                <argument>module</argument><argument>verify</argument><argument>${drishti.dmods}/genomics-0.1.0.dmod</argument><argument>--conformance</argument>
                <argument>--first-party</argument><argument>${drishti.dmods}/first-party.yaml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- the install (on by default; -Ddrishti.install.skip=true leaves the packages in target/dmod): every package, or the ids of
                 drishti.modules.ids, into the modules folder through a .part file and one replace, an older version of the same module removed,
                 then first-party.yaml of that folder -->
            <id>install-modules</id>
            <phase>package</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${drishti.install.skip}</skip>
              <arguments>
                <argument>module</argument><argument>install</argument><argument>${drishti.dmods}</argument>
                <argument>--into</argument><argument>${drishti.home.modules}</argument><argument>--only=${drishti.modules.ids}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <mainClass>com.ash.drishti.server.cli.ModuleCli</mainClass>
          <blockSystemExit>true</blockSystemExit>
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
