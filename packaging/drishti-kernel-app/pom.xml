<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-kernel-app</artifactId>
  <name>drishti-kernel-app</name>
  <description>The thin server jar (docs/architecture/KERNEL_AND_MODULES.md section 2.7, P2): the kernel (drishti-server) with no domain
    module, as one executable jar, packaging/drishti-kernel-app/target/drishti-kernel-VERSION-exec.jar. It holds no code. It boots with no modules
    and Health says so (modules: none). The full jar (drishti-app: the kernel with banking) stays the default; modules come to the thin
    jar as .dmod files from wave 2</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-server</artifactId></dependency>
  </dependencies>
  <build>
    <finalName>drishti-kernel-${project.version}</finalName>
    <plugins>
      <!-- the executable jar's manifest grants native access (RocksDB, SQLite, DuckDB, Hadoop load native libraries):
           JDK 25 warns without it and a future JDK blocks it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><archive><manifestEntries><Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access><Add-Opens>java.base/java.nio</Add-Opens></manifestEntries></archive></configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <classifier>exec</classifier>
          <mainClass>com.ash.drishti.server.DrishtiApplication</mainClass>
          <layout>ZIP</layout>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
