<!-- The genomics module (the SDK's sample, DISTRIBUTIONS.md section 4) in the one module layout: its .dmod content at this folder's top
     (module.yaml, packs/, console/, data/, docs/, elements/) and its code as the Maven project java/genomics, which this pom only
     aggregates. java/genomics's `mvn verify` builds the jar, packs this folder into target/dmod/genomics-0.1.0.dmod and runs C1-C15. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.helixlab</groupId>
  <artifactId>genomics-module</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>genomics-module</name>
  <modules>
    <module>java/genomics</module>
  </modules>
</project>
