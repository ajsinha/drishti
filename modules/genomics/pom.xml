<!-- A Drishti module project, made by drishti-module-archetype. `mvn verify` builds the jar, packs target/dmod/genomics-0.1.0.dmod
     and runs the conformance checks C1-C15 (docs/guides/DEVELOPER_GUIDE.md, the Module SDK). The genomics sample (DISTRIBUTIONS.md
     section 4) is built in the kernel's reactor too: there the parent is the SDK's own folder; a partner's project leaves relativePath
     empty and takes the parent from its Maven repository. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-module-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../drishti-sdk/drishti-module-parent/pom.xml</relativePath>
  </parent>
  <groupId>org.helixlab</groupId>
  <artifactId>genomics</artifactId>
  <version>0.1.0</version>
  <name>genomics</name>
  <dependencies>
    <!-- JSON lines (gene.jsonl): the kernel supplies Jackson at run time, so it is never inside the .dmod -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.21.4</version><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>com.ash.drishti</groupId>
        <artifactId>drishti-module-maven-plugin</artifactId>
        <!-- the fifteen checks at package: a reactor build (package -pl modules/genomics -am) proves the .dmod passes them -->
        <executions><execution><id>drishti-conformance</id><phase>package</phase></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
