<!-- A Drishti module project, made by drishti-module-archetype. `mvn package` builds the jar; packaging/dist packs the folder with it
     (the Python packager) and runs the conformance checks C1-C14 (docs/guides/DEVELOPER_GUIDE.md, the Module SDK). The genomics sample (KERNEL_AND_MODULES.md
     section 4) is built in the kernel's reactor too: there the parent is the SDK's own folder; a partner's project leaves relativePath
     empty and takes the parent from its Maven repository. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-module-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../../drishti-sdk/drishti-module-parent/pom.xml</relativePath>
  </parent>
  <groupId>org.helixlab</groupId>
  <artifactId>genomics</artifactId>
  <version>0.1.0</version>
  <name>genomics</name>
  <dependencies>
    <!-- JSON lines (gene.jsonl): the kernel supplies Jackson at run time, so it is never inside the .dmod -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.21.4</version><scope>provided</scope></dependency>
  </dependencies>
  <profiles>
    <!-- The SDK build: with -Ddrishti.home=<a Drishti install> the parent's exec executions run (validate the manifest, pack the .dmod, run the
         fourteen conformance checks), exactly as in a partner's project, which names the plugin in its own build (the archetype does). The
         kernel's reactor leaves drishti.home unset: packaging/dist packs this module there. -->
    <profile>
      <id>sdk-build</id>
      <activation><property><name>drishti.home</name></property></activation>
      <build>
        <plugins>
          <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId></plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
