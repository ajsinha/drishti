<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-trading</artifactId>
  <name>drishti-trading</name>
  <description>The trading module's server part (THIN_CONSOLE_DESIGN.md step S8a): the Trading landings' figures under /api/v1/trading/landing. It reads the kernel and the other modules only through their API, as the person (drishti-kernel-api): no kernel internals.</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-kernel-api</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <!-- the landing tests' stand-in server answers /pivot/inline with the engine's own reading (InlinePivot): never packed into the .dmod -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-bicompute</artifactId><scope>test</scope></dependency>
    <!-- and the kernel's own Caller.figures (InlinePivotFigures) and person cache, as the server and the conformance harness give them -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-module-runtime</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
