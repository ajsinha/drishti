<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-modules</artifactId>
  <name>drishti-modules</name>
  <description>The product's first-party modules as packages (docs/architecture/KERNEL_AND_MODULES.md section 3.3, DISTRIBUTIONS.md): banking
    (with its code and its kernel-internals allowance, stamped with the kernel build of this build), market-data, capital-markets and
    economy, each packed by the module tool into drishti/modules/ID-VERSION.dmod, and first-party.yaml (their ids and hash-list hashes).
    Banking goes through the fifteen conformance checks as part of the build. The full distribution (drishti-app) installs these modules
    by default; the thin jar (drishti-kernel-app) carries first-party.yaml only.</description>
  <properties>
    <drishti.dmods>${project.build.outputDirectory}/drishti/modules</drishti.dmods>
    <drishti.jars>${project.build.directory}/module-jars</drishti.jars>
    <skipTests>false</skipTests>
  </properties>
  <dependencies>
    <!-- the kernel on the tool's class path: its build (META-INF/build-info.properties) is the one banking is stamped for -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-server</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-module-runtime</artifactId></dependency>
    <!-- banking's jars go into its package, never on the kernel's class path -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-banking</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-compute-banking</artifactId><scope>provided</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>banking-jars</id>
            <phase>process-classes</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${drishti.jars}</outputDirectory>
              <stripVersion>true</stripVersion>
              <artifactItems>
                <artifactItem><groupId>com.ash.drishti</groupId><artifactId>drishti-banking</artifactId><version>${project.version}</version></artifactItem>
                <artifactItem><groupId>com.ash.drishti</groupId><artifactId>drishti-compute-banking</artifactId><version>${project.version}</version></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <mainClass>com.ash.drishti.module.tool.ModuleTool</mainClass>
          <blockSystemExit>true</blockSystemExit>
          <cleanupDaemonThreads>false</cleanupDaemonThreads>
        </configuration>
        <executions>
          <execution>
            <id>pack-banking</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>pack</argument><argument>${project.basedir}/../banking/dmod</argument>
                <argument>--jar</argument><argument>${drishti.jars}/drishti-banking.jar</argument>
                <argument>--more</argument><argument>${drishti.jars}/drishti-compute-banking.jar</argument>
                <argument>--out</argument><argument>${drishti.dmods}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-market-data</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments><argument>pack</argument><argument>${project.basedir}/../market-data</argument><argument>--out</argument><argument>${drishti.dmods}</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-capital-markets</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments><argument>pack</argument><argument>${project.basedir}/../capital-markets</argument><argument>--out</argument><argument>${drishti.dmods}</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>pack-economy</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments><argument>pack</argument><argument>${project.basedir}/../economy</argument><argument>--out</argument><argument>${drishti.dmods}</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>first-party</id>
            <phase>process-classes</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <arguments>
                <argument>first-party</argument><argument>${drishti.dmods}</argument>
                <argument>--out</argument><argument>${project.build.outputDirectory}/META-INF/drishti/first-party.yaml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <!-- the fifteen conformance checks on banking, against this build's kernel and first-party list -->
            <id>check-banking</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <skip>${skipTests}</skip>
              <arguments>
                <argument>check</argument><argument>${drishti.dmods}/banking-1.0.0.dmod</argument>
                <argument>--first-party</argument><argument>${project.build.outputDirectory}/META-INF/drishti/first-party.yaml</argument>
                <argument>--with</argument><argument>${drishti.dmods}/market-data-1.0.0.dmod</argument>
                <argument>--cycles</argument><argument>2</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
