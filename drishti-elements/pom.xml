<!-- The WebJar of Drishti Elements (docs/guides/ELEMENTS_IN_YOUR_APP.md, Install › A WebJar): the libraries' files under
     META-INF/resources/webjars/drishti-elements/<version>/, so a Java web application (Spring Boot serves /webjars/** by itself) takes
     them as a Maven dependency. Built only in the profile `elements` (mvn -P elements -pl drishti-elements package); the files are
     written by tools/elements/cli.py webjar-tree (Python 3 with PyYAML: the same code as the zip and the npm tarballs, so the three
     forms hold the same bytes). The version is the Elements release train's (drishti_elements.json, "elements"), not the product's:
     the tool refuses a mismatch. Never deployed to a public repository: an internal Artifactory or Nexus only. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.d</version>
  </parent>

  <artifactId>drishti-elements</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Drishti Elements (WebJar)</name>
  <description>Drishti Elements, the JavaScript and CSS libraries, as a WebJar</description>

  <properties>
    <drishti.python>python3</drishti.python>
    <drishti.elements.target>${project.basedir}/target</drishti.elements.target>
  </properties>

  <build>
    <!-- overridable (-Ddrishti.elements.target=…) so a test builds the jar in its own temporary folder -->
    <directory>${drishti.elements.target}</directory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>webjar-tree</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${drishti.python}</executable>
              <arguments>
                <argument>${project.basedir}/../tools/elements/cli.py</argument>
                <argument>webjar-tree</argument>
                <argument>--out</argument>
                <argument>${project.build.outputDirectory}</argument>
                <argument>--version</argument>
                <argument>${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
