<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheetPr><tabColor rgb="FF1F3A5F"/></sheetPr><sheetViews><sheetView workbookViewId="0" tabSelected="1"><pane ySplit="3" topLeftCell="A4" activePane="bottomLeft" state="frozen"/></sheetView></sheetViews><sheetFormatPr defaultRowHeight="14"/><cols><col min="1" max="1" width="46" customWidth="1"/><col min="2" max="2" width="20" customWidth="1"/><col min="3" max="3" width="12" customWidth="1"/><col min="4" max="4" width="20" customWidth="1"/><col min="5" max="5" width="90" customWidth="1"/></cols><sheetData><row r="1"><c r="A1" s="1" t="inlineStr"><is><t xml:space="preserve">{{PRODUCT}} · Single-node sizing planner: inputs</t></is></c><c r="B1" s="1"/><c r="C1" s="1"/><c r="D1" s="1"/><c r="E1" s="1"/></row><row r="2"><c r="A2" s="5" t="inlineStr"><is><t xml:space="preserve">Type your expected loads into the yellow cells; Results recomputes everything. Defaults are the 1,000,000-position benchmark's shape.</t></is></c></row><row r="3"><c r="A3" s="3" t="inlineStr"><is><t xml:space="preserve">Input</t></is></c><c r="B3" s="3" t="inlineStr"><is><t xml:space="preserve">Value</t></is></c><c r="C3" s="3" t="inlineStr"><is><t xml:space="preserve">Unit</t></is></c><c r="D3" s="3" t="inlineStr"><is><t xml:space="preserve">Name</t></is></c><c r="E3" s="3" t="inlineStr"><is><t xml:space="preserve">Hint</t></is></c></row><row r="4"><c r="A4" s="2" t="inlineStr"><is><t xml:space="preserve">VaR</t></is></c><c r="B4" s="2"/><c r="C4" s="2"/><c r="D4" s="2"/><c r="E4" s="2"/></row><row r="5"><c r="A5" s="18" t="inlineStr"><is><t xml:space="preserve">Positions a business date</t></is></c><c r="B5" s="27"><v>300000</v></c><c r="C5" s="4" t="inlineStr"><is><t xml:space="preserve">positions</t></is></c><c r="D5" s="5" t="inlineStr"><is><t xml:space="preserve">Positions</t></is></c><c r="E5" s="22" t="inlineStr"><is><t xml:space="preserve">How many positions one business date holds. Default: the production shape, OTC trades, one trade a position, so positions = trades.</t></is></c></row><row r="6"><c r="A6" s="18" t="inlineStr"><is><t xml:space="preserve">Trades a business date</t></is></c><c r="B6" s="27"><v>300000</v></c><c r="C6" s="4" t="inlineStr"><is><t xml:space="preserve">trades</t></is></c><c r="D6" s="5" t="inlineStr"><is><t xml:space="preserve">Trades</t></is></c><c r="E6" s="22" t="inlineStr"><is><t xml:space="preserve">How many trades those positions are made of. Default: production, about 300,000 trades.</t></is></c></row><row r="7"><c r="A7" s="18" t="inlineStr"><is><t xml:space="preserve">Trades per position, of positions that hold several</t></is></c><c r="B7" s="9"><v>2</v></c><c r="C7" s="4" t="inlineStr"><is><t xml:space="preserve">trades</t></is></c><c r="D7" s="5" t="inlineStr"><is><t xml:space="preserve">TradesPerFungible</t></is></c><c r="E7" s="22" t="inlineStr"><is><t xml:space="preserve">Only used when trades exceed positions: how many trades a shared (fungible) position holds on average.</t></is></c></row><row r="8"><c r="A8" s="18" t="inlineStr"><is><t xml:space="preserve">Portfolios</t></is></c><c r="B8" s="27"><v>4500</v></c><c r="C8" s="4" t="inlineStr"><is><t xml:space="preserve">portfolios</t></is></c><c r="D8" s="5" t="inlineStr"><is><t xml:space="preserve">Portfolios</t></is></c><c r="E8" s="22" t="inlineStr"><is><t xml:space="preserve">Stored portfolios: baskets, rule portfolios, desk and book portfolios. Default: 300,000 ÷ 1,000,000 of the 1,000,000-position benchmark's 15,000 (desks and books grow with the positions: a desk holds 2,000 positions at both benchmark sizes, BENCHMARK.md 3).</t></is></c></row><row r="9"><c r="A9" s="18" t="inlineStr"><is><t xml:space="preserve">Basket members</t></is></c><c r="B9" s="27"><v>600000</v></c><c r="C9" s="4" t="inlineStr"><is><t xml:space="preserve">members</t></is></c><c r="D9" s="5" t="inlineStr"><is><t xml:space="preserve">BasketMembers</t></is></c><c r="E9" s="22" t="inlineStr"><is><t xml:space="preserve">Positions named by all the baskets together. Default: 300,000 ÷ 1,000,000 of the 1,000,000-position benchmark's 2,000,000.</t></is></c></row><row r="10"><c r="A10" s="18" t="inlineStr"><is><t xml:space="preserve">Hierarchy nodes</t></is></c><c r="B10" s="27"><v>8107</v></c><c r="C10" s="4" t="inlineStr"><is><t xml:space="preserve">nodes</t></is></c><c r="D10" s="5" t="inlineStr"><is><t xml:space="preserve">Nodes</t></is></c><c r="E10" s="22" t="inlineStr"><is><t xml:space="preserve">Nodes of every risk hierarchy (bank, legal entities, divisions, desks, limit letters...). Default: 300,000 ÷ 1,000,000 of the 1,000,000-position benchmark's 27,024.</t></is></c></row><row r="11"><c r="A11" s="18" t="inlineStr"><is><t xml:space="preserve">Books and cells</t></is></c><c r="B11" s="27"><v>39000</v></c><c r="C11" s="4" t="inlineStr"><is><t xml:space="preserve">books + cells</t></is></c><c r="D11" s="5" t="inlineStr"><is><t xml:space="preserve">BooksCells</t></is></c><c r="E11" s="22" t="inlineStr"><is><t xml:space="preserve">Trading books plus the cells of column hierarchies. Default: 300,000 ÷ 1,000,000 of the 1,000,000-position benchmark's 130,000.</t></is></c></row><row r="12"><c r="A12" s="18" t="inlineStr"><is><t xml:space="preserve">Scenarios</t></is></c><c r="B12" s="27"><v>509</v></c><c r="C12" s="4" t="inlineStr"><is><t xml:space="preserve">scenarios</t></is></c><c r="D12" s="5" t="inlineStr"><is><t xml:space="preserve">Scenarios</t></is></c><c r="E12" s="22" t="inlineStr"><is><t xml:space="preserve">Scenario days in a P&amp;L vector (509: two years of history plus the base).</t></is></c></row><row r="13"><c r="A13" s="18" t="inlineStr"><is><t xml:space="preserve">Trade currencies per node</t></is></c><c r="B13" s="9"><v>1</v></c><c r="C13" s="4" t="inlineStr"><is><t xml:space="preserve">currencies</t></is></c><c r="D13" s="5" t="inlineStr"><is><t xml:space="preserve">TradeCcysPerNode</t></is></c><c r="E13" s="22" t="inlineStr"><is><t xml:space="preserve">On average, how many trade currencies a node's trades are in.</t></is></c></row><row r="14"><c r="A14" s="18" t="inlineStr"><is><t xml:space="preserve">Years of business dates kept in the lake</t></is></c><c r="B14" s="9"><v>1</v></c><c r="C14" s="4" t="inlineStr"><is><t xml:space="preserve">years</t></is></c><c r="D14" s="5" t="inlineStr"><is><t xml:space="preserve">LakeYears</t></is></c><c r="E14" s="22" t="inlineStr"><is><t xml:space="preserve">How much history the lake keeps (the bank's rule is often 7 years).</t></is></c></row><row r="15"><c r="A15" s="18" t="inlineStr"><is><t xml:space="preserve">Dates in memory (hot-dates)</t></is></c><c r="B15" s="27"><v>10</v></c><c r="C15" s="4" t="inlineStr"><is><t xml:space="preserve">dates</t></is></c><c r="D15" s="5" t="inlineStr"><is><t xml:space="preserve">HotDates</t></is></c><c r="E15" s="22" t="inlineStr"><is><t xml:space="preserve">Business dates kept open at once; the least recently used one leaves first.</t></is></c></row><row r="16"><c r="A16" s="18" t="inlineStr"><is><t xml:space="preserve">Pinned dates kept in memory</t></is></c><c r="B16" s="27"><v>0</v></c><c r="C16" s="4" t="inlineStr"><is><t xml:space="preserve">dates</t></is></c><c r="D16" s="5" t="inlineStr"><is><t xml:space="preserve">PinnedMem</t></is></c><c r="E16" s="22" t="inlineStr"><is><t xml:space="preserve">Dates that must always stay open (a month-end the desks compare with, an audit date).</t></is></c></row><row r="17"><c r="A17" s="18" t="inlineStr"><is><t xml:space="preserve">Pinned dates kept on disk</t></is></c><c r="B17" s="27"><v>0</v></c><c r="C17" s="4" t="inlineStr"><is><t xml:space="preserve">dates</t></is></c><c r="D17" s="5" t="inlineStr"><is><t xml:space="preserve">PinnedDisk</t></is></c><c r="E17" s="22" t="inlineStr"><is><t xml:space="preserve">Dates whose hot file is always kept on local disk, so they open in a second (month-ends, year-ends).</t></is></c></row><row r="18"><c r="A18" s="18" t="inlineStr"><is><t xml:space="preserve">Reporting currencies built ahead (besides USD)</t></is></c><c r="B18" s="27"><v>0</v></c><c r="C18" s="4" t="inlineStr"><is><t xml:space="preserve">currencies</t></is></c><c r="D18" s="5" t="inlineStr"><is><t xml:space="preserve">CcysAhead</t></is></c><c r="E18" s="22" t="inlineStr"><is><t xml:space="preserve">Each one is a whole extra book a date (the shipped setting builds 4: EUR, CAD, JPY, GBP).</t></is></c></row><row r="19"><c r="A19" s="18" t="inlineStr"><is><t xml:space="preserve">Stress set on (1) or off (0)</t></is></c><c r="B19" s="27"><v>0</v></c><c r="C19" s="4" t="inlineStr"><is><t xml:space="preserve">0 or 1</t></is></c><c r="D19" s="5" t="inlineStr"><is><t xml:space="preserve">StressOn</t></is></c><c r="E19" s="22" t="inlineStr"><is><t xml:space="preserve">1 when stressed VaR is used: the stress set is a book of its own a date.</t></is></c></row><row r="20"><c r="A20" s="18" t="inlineStr"><is><t xml:space="preserve">Intraday batches a day</t></is></c><c r="B20" s="27"><v>10</v></c><c r="C20" s="4" t="inlineStr"><is><t xml:space="preserve">batches</t></is></c><c r="D20" s="5" t="inlineStr"><is><t xml:space="preserve">IntradayBatches</t></is></c><c r="E20" s="22" t="inlineStr"><is><t xml:space="preserve">Intraday batches applied to today's date. Default 10 (hourly over the trading day): assumed, confirm the batch count.</t></is></c></row><row r="21"><c r="A21" s="18" t="inlineStr"><is><t xml:space="preserve">Updates per intraday batch</t></is></c><c r="B21" s="27"><v>11700</v></c><c r="C21" s="4" t="inlineStr"><is><t xml:space="preserve">trades</t></is></c><c r="D21" s="5" t="inlineStr"><is><t xml:space="preserve">UpdatesPerBatch</t></is></c><c r="E21" s="22" t="inlineStr"><is><t xml:space="preserve">Trades amended, added or cancelled in one batch. Default: 39% of the 300,000 trades a day (117,000) over the 10 batches.</t></is></c></row><row r="22"><c r="A22" s="2" t="inlineStr"><is><t xml:space="preserve">Exposure</t></is></c><c r="B22" s="2"/><c r="C22" s="2"/><c r="D22" s="2"/><c r="E22" s="2"/></row><row r="23"><c r="A23" s="18" t="inlineStr"><is><t xml:space="preserve">Exposure on (1) or off (0)</t></is></c><c r="B23" s="27"><v>0</v></c><c r="C23" s="4" t="inlineStr"><is><t xml:space="preserve">0 or 1</t></is></c><c r="D23" s="5" t="inlineStr"><is><t xml:space="preserve">ExposureOn</t></is></c><c r="E23" s="22" t="inlineStr"><is><t xml:space="preserve">1 when the counterparty exposure engine serves dates on this server.</t></is></c></row><row r="24"><c r="A24" s="18" t="inlineStr"><is><t xml:space="preserve">Netting sets</t></is></c><c r="B24" s="27"><v>10000</v></c><c r="C24" s="4" t="inlineStr"><is><t xml:space="preserve">sets</t></is></c><c r="D24" s="5" t="inlineStr"><is><t xml:space="preserve">NettingSets</t></is></c><c r="E24" s="22" t="inlineStr"><is><t xml:space="preserve">Netting sets a business date.</t></is></c></row><row r="25"><c r="A25" s="18" t="inlineStr"><is><t xml:space="preserve">Exposure trades</t></is></c><c r="B25" s="27"><v>100000</v></c><c r="C25" s="4" t="inlineStr"><is><t xml:space="preserve">trades</t></is></c><c r="D25" s="5" t="inlineStr"><is><t xml:space="preserve">ExpTrades</t></is></c><c r="E25" s="22" t="inlineStr"><is><t xml:space="preserve">Trades with simulated paths a business date.</t></is></c></row><row r="26"><c r="A26" s="18" t="inlineStr"><is><t xml:space="preserve">Paths</t></is></c><c r="B26" s="27"><v>200</v></c><c r="C26" s="4" t="inlineStr"><is><t xml:space="preserve">paths</t></is></c><c r="D26" s="5" t="inlineStr"><is><t xml:space="preserve">Paths</t></is></c><c r="E26" s="22" t="inlineStr"><is><t xml:space="preserve">Monte Carlo paths a trade.</t></is></c></row><row r="27"><c r="A27" s="18" t="inlineStr"><is><t xml:space="preserve">Time steps</t></is></c><c r="B27" s="27"><v>24</v></c><c r="C27" s="4" t="inlineStr"><is><t xml:space="preserve">grid dates</t></is></c><c r="D27" s="5" t="inlineStr"><is><t xml:space="preserve">TimeSteps</t></is></c><c r="E27" s="22" t="inlineStr"><is><t xml:space="preserve">Grid dates of a path.</t></is></c></row><row r="28"><c r="A28" s="18" t="inlineStr"><is><t xml:space="preserve">Exposure dates in memory</t></is></c><c r="B28" s="27"><v>10</v></c><c r="C28" s="4" t="inlineStr"><is><t xml:space="preserve">dates</t></is></c><c r="D28" s="5" t="inlineStr"><is><t xml:space="preserve">ExpHotDates</t></is></c><c r="E28" s="22" t="inlineStr"><is><t xml:space="preserve">drishti.ccr.exposure.hot-dates: exposure dates kept open.</t></is></c></row><row r="29"><c r="A29" s="2" t="inlineStr"><is><t xml:space="preserve">Trades and BI</t></is></c><c r="B29" s="2"/><c r="C29" s="2"/><c r="D29" s="2"/><c r="E29" s="2"/></row><row r="30"><c r="A30" s="18" t="inlineStr"><is><t xml:space="preserve">Trade and BI rows a day</t></is></c><c r="B30" s="27"><v>300000</v></c><c r="C30" s="4" t="inlineStr"><is><t xml:space="preserve">rows</t></is></c><c r="D30" s="5" t="inlineStr"><is><t xml:space="preserve">TradeRowsPerDay</t></is></c><c r="E30" s="22" t="inlineStr"><is><t xml:space="preserve">Trade rows loaded a business date, all trade systems together. Default: the same 300,000 production trades, served as trades too.</t></is></c></row><row r="31"><c r="A31" s="18" t="inlineStr"><is><t xml:space="preserve">Days of trade rows kept</t></is></c><c r="B31" s="27"><v>252</v></c><c r="C31" s="4" t="inlineStr"><is><t xml:space="preserve">days</t></is></c><c r="D31" s="5" t="inlineStr"><is><t xml:space="preserve">TradeDaysKept</t></is></c><c r="E31" s="22" t="inlineStr"><is><t xml:space="preserve">Business days of trades kept in the lake (252 is a year).</t></is></c></row><row r="32"><c r="A32" s="18" t="inlineStr"><is><t xml:space="preserve">Trade connectors</t></is></c><c r="B32" s="27"><v>3</v></c><c r="C32" s="4" t="inlineStr"><is><t xml:space="preserve">connectors</t></is></c><c r="D32" s="5" t="inlineStr"><is><t xml:space="preserve">TradeConnectors</t></is></c><c r="E32" s="22" t="inlineStr"><is><t xml:space="preserve">Trade systems read through their own connector (for example ENDUR, CALYPSO, MUREX).</t></is></c></row><row r="33"><c r="A33" s="2" t="inlineStr"><is><t xml:space="preserve">Users</t></is></c><c r="B33" s="2"/><c r="C33" s="2"/><c r="D33" s="2"/><c r="E33" s="2"/></row><row r="34"><c r="A34" s="18" t="inlineStr"><is><t xml:space="preserve">Concurrent users</t></is></c><c r="B34" s="27"><v>50</v></c><c r="C34" s="4" t="inlineStr"><is><t xml:space="preserve">users</t></is></c><c r="D34" s="5" t="inlineStr"><is><t xml:space="preserve">Users</t></is></c><c r="E34" s="22" t="inlineStr"><is><t xml:space="preserve">People (or programs) asking questions at the same moment at the busiest time.</t></is></c></row><row r="35"><c r="A35" s="18" t="inlineStr"><is><t xml:space="preserve">Peak requests a second wanted</t></is></c><c r="B35" s="9"><v>100</v></c><c r="C35" s="4" t="inlineStr"><is><t xml:space="preserve">requests/s</t></is></c><c r="D35" s="5" t="inlineStr"><is><t xml:space="preserve">PeakRps</t></is></c><c r="E35" s="22" t="inlineStr"><is><t xml:space="preserve">Requests a second the server must answer at the peak.</t></is></c></row><row r="36"><c r="A36" s="18" t="inlineStr"><is><t xml:space="preserve">Share of VaR questions</t></is></c><c r="B36" s="9"><v>0.5</v></c><c r="C36" s="4" t="inlineStr"><is><t xml:space="preserve">share</t></is></c><c r="D36" s="5" t="inlineStr"><is><t xml:space="preserve">VarShare</t></is></c><c r="E36" s="22" t="inlineStr"><is><t xml:space="preserve">Of those requests, the share that are VaR questions (the rest are trades, searches, pages).</t></is></c></row><row r="37"><c r="A37" s="2" t="inlineStr"><is><t xml:space="preserve">Machine</t></is></c><c r="B37" s="2"/><c r="C37" s="2"/><c r="D37" s="2"/><c r="E37" s="2"/></row><row r="38"><c r="A38" s="18" t="inlineStr"><is><t xml:space="preserve">Java version (21 or 25)</t></is></c><c r="B38" s="27"><v>21</v></c><c r="C38" s="4" t="inlineStr"><is><t xml:space="preserve">21 or 25</t></is></c><c r="D38" s="5" t="inlineStr"><is><t xml:space="preserve">JavaVersion</t></is></c><c r="E38" s="22" t="inlineStr"><is><t xml:space="preserve">The Java the server runs on; 25 adds compact object headers.</t></is></c></row><row r="39"><c r="A39" s="18" t="inlineStr"><is><t xml:space="preserve">Load threads (drishti.var.load-threads)</t></is></c><c r="B39" s="27"><v>2</v></c><c r="C39" s="4" t="inlineStr"><is><t xml:space="preserve">threads</t></is></c><c r="D39" s="5" t="inlineStr"><is><t xml:space="preserve">LoadThreads</t></is></c><c r="E39" s="22" t="inlineStr"><is><t xml:space="preserve">Dates that may load from the lake at the same time.</t></is></c></row><row r="40"><c r="A40" s="18" t="inlineStr"><is><t xml:space="preserve">Garbage collector: auto, G1 or ZGC</t></is></c><c r="B40" s="7" t="inlineStr"><is><t xml:space="preserve">auto</t></is></c><c r="C40" s="4" t="inlineStr"><is><t xml:space="preserve">text</t></is></c><c r="D40" s="5" t="inlineStr"><is><t xml:space="preserve">Collector</t></is></c><c r="E40" s="22" t="inlineStr"><is><t xml:space="preserve">auto follows the documented rule: generational ZGC from 16 GB of heap, G1 below.</t></is></c></row><row r="41"><c r="A41" s="18" t="inlineStr"><is><t xml:space="preserve">Data folder</t></is></c><c r="B41" s="7" t="inlineStr"><is><t xml:space="preserve">/opt/drishti/data</t></is></c><c r="C41" s="4" t="inlineStr"><is><t xml:space="preserve">path</t></is></c><c r="D41" s="5" t="inlineStr"><is><t xml:space="preserve">DataFolder</t></is></c><c r="E41" s="22" t="inlineStr"><is><t xml:space="preserve">Where Drishti keeps everything it writes (dumps, logs and temporary files go under it).</t></is></c></row><row r="42"><c r="A42" s="18" t="inlineStr"><is><t xml:space="preserve">Server jar</t></is></c><c r="B42" s="7" t="inlineStr"><is><t xml:space="preserve">drishti-server-2.9.10-exec.jar</t></is></c><c r="C42" s="4" t="inlineStr"><is><t xml:space="preserve">file</t></is></c><c r="D42" s="5" t="inlineStr"><is><t xml:space="preserve">ServerJar</t></is></c><c r="E42" s="22" t="inlineStr"><is><t xml:space="preserve">The server's jar, as the command line starts it.</t></is></c></row></sheetData><dataValidations count="4"><dataValidation type="list" allowBlank="0" showErrorMessage="1" sqref="B19"><formula1>"0,1"</formula1></dataValidation><dataValidation type="list" allowBlank="0" showErrorMessage="1" sqref="B23"><formula1>"0,1"</formula1></dataValidation><dataValidation type="list" allowBlank="0" showErrorMessage="1" sqref="B38"><formula1>"21,25"</formula1></dataValidation><dataValidation type="list" allowBlank="0" showErrorMessage="1" sqref="B40"><formula1>"auto,G1,ZGC"</formula1></dataValidation></dataValidations><pageMargins left="0.4" right="0.4" top="0.5" bottom="0.6" header="0.2" footer="0.25"/><pageSetup orientation="landscape" fitToWidth="1" fitToHeight="0"/></worksheet>