<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>1.12.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-server</artifactId>
  <name>drishti-server</name>
  <description>The Drishti Spring Boot application</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-engine</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-identity</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-packs</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-demo</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-file</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-delta</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-aerospike</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-redis</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-mongodb</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-iceberg</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-duckdb</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-feeds</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-kafka</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-activemq</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-rabbitmq</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-s3</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-rest</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <drishti.identity.users-file>${project.build.directory}/identity/users.json</drishti.identity.users-file>
            <drishti.identity.audit-file>${project.build.directory}/identity/audit.jsonl</drishti.identity.audit-file>
            <drishti.identity.iterations>1000</drishti.identity.iterations>
            <drishti.packs.dir>${project.basedir}/../packs</drishti.packs.dir>
            <drishti.rachana.dirs>${project.build.directory}/no-site-sutras</drishti.rachana.dirs>
            <drishti.identity.preferences-dir>${project.build.directory}/identity/preferences</drishti.identity.preferences-dir>
            <drishti.governance.dir>${project.build.directory}/governance</drishti.governance.dir>
            <DRISHTI_CACHE_ROOT>${project.build.directory}/cache</DRISHTI_CACHE_ROOT>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <!-- the executable jar's manifest grants native access (RocksDB, SQLite, DuckDB, Hadoop load native libraries):
           JDK 25 warns without it and a future JDK blocks it -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration><archive><manifestEntries><Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access></manifestEntries></archive></configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions><execution><goals><goal>build-info</goal></goals></execution></executions>
        <configuration><classifier>exec</classifier><mainClass>com.ash.drishti.server.DrishtiApplication</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
