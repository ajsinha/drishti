target/
*.class
*.log
.idea/
*.iml
.vscode/
.DS_Store
__pycache__/
*.pyc
.venv/
.pytest_cache/
application.local.yaml
hs_err_pid*
# everything under data/ is generated or written at run time (lake, JSON lines, feeds, identity database, reports):
# make it with tools/packgen/banking/make_data.py, never commit it; the one exception is the committed test data,
# data/testdata (tools/testdata/make_testdata.py writes it, `drishti.py lake demo` builds the demo lakes from it)
/data/*
!/data/testdata/
# the lakes' folders are kept in git (each with only its README.md); what a build or a load writes there is never committed
!/data/delta/
/data/delta/*
!/data/delta/demo/
/data/delta/demo/*
!/data/delta/demo/README.md
!/data/delta/risklake/
/data/delta/risklake/*
!/data/delta/risklake/README.md
!/data/delta/newslake/
/data/delta/newslake/*
!/data/delta/newslake/README.md
!/data/delta/worldlake/
/data/delta/worldlake/*
!/data/delta/worldlake/README.md
!/data/delta/regulators/
/data/delta/regulators/*
!/data/delta/regulators/README.md
!/data/delta/capitalmarket/
/data/delta/capitalmarket/*
!/data/delta/capitalmarket/README.md
!/data/delta/referencelake/
/data/delta/referencelake/*
!/data/delta/referencelake/README.md
.claude/
# the Python runtime of Calc: installed by tools/fetch-pyodide.sh (pinned and verified), never committed
drishti-console/web/static/vendor/pyodide/
# DuckDB-Wasm (Rupaka proof of concept): installed by tools/fetch-duckdb-wasm.sh (pinned and verified), never committed
drishti-console/web/static/vendor/duckdb-wasm/*/

# site connector files (written by the server and by Admin -> Connectors; examples are in config/connectors.examples/)
/config/connectors/
# this site's Drishti*net files (written by the server, Admin -> Net and drishti.py net; examples are in config/net.examples/)
/config/net/
# this site's data bindings (written by the upgrade and Admin -> Data bindings; the format: docs/guides/DATA_LAKE_GUIDE.md section 6.1)
/config/bindings.yaml
/config/bindings.yaml.bak

# the framework builds of the embedding samples: docs/guides/examples/embed/fetch-vendor.sh
docs/guides/examples/embed/vendor/

# your own libraries (external_lib/README.md): not part of the repository
external_lib/java/*
!external_lib/java/README.md
external_lib/python/*
!external_lib/python/README.md

# the QA run configurations (run-configs/): the QA profile own data folder, lake and packs

# runtime data a module's tests or tools might make beside the module (the data folder is the repository root's data/ only)
/drishti-*/data/
/*/drishti-*/data/
/plugins/*/data/

# deploy/stack/ (the local Drishti*net cluster, deploy/stack/README.md): the repository is public, so its secrets (the token, session and
# cluster keys; any net-key file) and its run folder (the copy of the server jar, process ids, logs) are never committed; its node data and
# lakes are under data/stack/ (data/ above). tools/test_no_hidden_names.py fails if one is tracked anyway. The folder was drishti-stack/
# before 2.9.11.i4: its secrets.env and run/ stay ignored there for one release, until they are moved to deploy/stack/.
/deploy/stack/secrets.env
/deploy/stack/run/
/drishti-stack/secrets.env
/drishti-stack/run/
net-key
# the AWS scripts' settings (deploy/aws/env, copied from deploy/aws/env.example): account ids and resource names, never committed
/deploy/aws/env
# the compose stack's secrets (deploy/.env, passed with --env-file; docs/guides/OPERATIONS_GUIDE.md): never committed
/deploy/.env

# downloaded test tools (the MinIO server binary for the S3 tests): tools/cache, never committed
/tools/cache/

# the Java and Python API references (tools/api_docs.py build; IMPLEMENTATION_PLAN row 2g): generated at build time, never committed;
# the console serves them at Help -> Developer
drishti-console/web/apidocs/

# test scratch (TMPDIR and --basetemp of local runs, under the worktree)
drishti-console/test-tmp/

# maven-shade-plugin (the module tool jar of drishti-module-runtime) may leave its reduced pom beside the pom
dependency-reduced-pom.xml
