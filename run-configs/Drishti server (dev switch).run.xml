      <env name="DRISHTI_PORT" value="18580" />
      <env name="DRISHTI_DATA_DIR" value="$PROJECT_DIR$/data/qa/data" />
      <env name="LOGGING_LEVEL_COM_ASH_DRISHTI" value="DEBUG" />
      <env name="DRISHTI_MODULES_DEV" value="true" />
