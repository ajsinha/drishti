<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="Drishti server (demo lakes)" type="Application" factoryName="Application" folderName="Drishti">
    <option name="MAIN_CLASS_NAME" value="com.ash.drishti.server.DrishtiApplication" />
    <module name="drishti-server" />
    <option name="VM_PARAMETERS" value="-Djava.io.tmpdir=$PROJECT_DIR$/data/tmp/server -Xmx4g -XX:MaxDirectMemorySize=256m -XX:TrimNativeHeapInterval=60000" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <envs>
      <env name="MALLOC_ARENA_MAX" value="2" />
      <env name="DRISHTI_PACKS" value="core,market-data,trading,counterparty-risk,market-risk,world-economy,news-and-markets,us-equities,gleif" />
      <env name="DRISHTI_STUDIO_SAVE" value="true" />
      <env name="DRISHTI_SECURITY_ENABLED" value="true" />
      <env name="DRISHTI_TOKEN_SECRET" value="drishti-dev-only-token-secret-change-me-0123456789" />
      <env name="DRISHTI_SEED_ADMIN" value="true" />
      <env name="DRISHTI_SEED_USERNAME" value="drishti-dev-admin" />
      <env name="DRISHTI_SEED_PASSWORD" value="drishti-dev-admin123" />
      <env name="DRISHTI_EXTERNAL_LIB" value="$PROJECT_DIR$/external_lib" />
      <env name="DRISHTI_PORT" value="18480" />
      <env name="DRISHTI_DEMO_ENABLED" value="false" />
      <env name="DRISHTI_OFFLINE" value="true" />
