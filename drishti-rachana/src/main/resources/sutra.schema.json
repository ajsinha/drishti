{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:drishti:sutra",
 "title": "Drishti Sutra",
 "description": "Copyright (c) 2026 Ashutosh Sinha. All rights reserved. Proprietary and confidential. Editor aid; the authoritative validator is SutraParser.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "sutra",
  "version",
  "match"
 ],
 "properties": {
  "sutra": {
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{1,63}$"
  },
  "version": {
   "type": "integer",
   "minimum": 1
  },
  "description": {
   "type": "string"
  },
  "domain": {
   "type": "string"
  },
  "match": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "type": "string"
    },
    "where": {
     "type": "string"
    },
    "priority": {
     "type": "integer"
    }
   }
  },
  "title": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "pill": {
     "type": "string"
    },
    "id": {
     "type": "string"
    },
    "with": {
     "type": "string"
    }
   }
  },
  "strip": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "bind"
    ],
    "properties": {
     "label": {
      "type": "string"
     },
     "bind": {
      "type": "string"
     },
     "fmt": {
      "$ref": "#/$defs/fmt"
     },
     "tone": {
      "type": "string"
     },
     "emphasis": {
      "type": "boolean"
     }
    }
   }
  },
  "panels": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/panel"
   }
  },
  "keys": {
   "type": "object",
   "propertyNames": {
    "$ref": "#/$defs/fkey"
   },
   "additionalProperties": {
    "type": "string"
   }
  }
 },
 "$defs": {
  "fkey": {
   "type": "string",
   "pattern": "^F([1-9]|1[0-2])$"
  },
  "fmt": {
   "type": "string"
  },
  "column": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "bind"
   ],
   "properties": {
    "label": {
     "type": "string"
    },
    "bind": {
     "type": "string",
     "description": "Sutra-EL; @ is the row"
    },
    "fmt": {
     "$ref": "#/$defs/fmt"
    },
    "tone": {
     "type": "string",
     "enum": [
      "sign",
      "pos",
      "neg",
      "status",
      "link",
      "accent"
     ]
    },
    "total": {
     "type": "boolean"
    },
    "link": {
     "type": "boolean"
    }
   }
  },
  "panel": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
     "enum": [
      "kv",
      "table",
      "tabs",
      "line",
      "area",
      "hbar",
      "ladder",
      "links",
      "status",
      "provenance",
      "markdown",
      "gauge",
      "surface"
     ]
    },
    "title": {
     "type": "string"
    },
    "key": {
     "$ref": "#/$defs/fkey"
    },
    "code": {
     "type": "string"
    },
    "area": {
     "enum": [
      "main",
      "right"
     ]
    },
    "infer": {
     "type": "boolean"
    },
    "columns": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/column"
     }
    },
    "body": {
     "$ref": "#/$defs/panel"
    },
    "rows": {
     "type": "string"
    },
    "each": {
     "type": "string"
    },
    "tabTitle": {
     "type": "string"
    },
    "layout": {
     "enum": [
      "tabs",
      "columns"
     ]
    },
    "source": {
     "type": "string"
    },
    "x": {
     "type": "string"
    },
    "y": {
     "type": "string"
    },
    "mark": {
     "type": "string"
    },
    "unit": {
     "type": "string"
    },
    "series": {
     "type": "array"
    },
    "limit": {},
    "limitLabel": {
     "type": "string"
    },
    "label": {
     "type": "string"
    },
    "value": {
     "type": "string"
    },
    "fmt": {
     "$ref": "#/$defs/fmt"
    },
    "tone": {
     "type": "string"
    },
    "totalLabel": {
     "type": "string"
    },
    "moreLabel": {
     "type": "string"
    },
    "highlight": {
     "type": "string"
    },
    "fields": {
     "type": "array"
    },
    "text": {
     "type": "string"
    },
    "max": {},
    "footer": {
     "type": "string"
    }
   }
  }
 }
}
