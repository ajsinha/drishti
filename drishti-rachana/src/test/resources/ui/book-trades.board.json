{
  "rachana": 1,
  "board": "book-trades",
  "version": 7,
  "title": "Book trades",
  "description": "A book's trades over a date range; the selected trade's ticket and its cash flows beside it.",
  "params": {
    "as-of": {
      "type": "date",
      "default": "today"
    },
    "book": {
      "type": "id",
      "of": "trading/book",
      "default": "FX-LDN-01"
    }
  },
  "chips": {
    "trades": {
      "use": "filterable-table@2",
      "title": "Trades",
      "supply": {
        "connector": "trading/trade-search",
        "query": {
          "book": "%{board.params.book}"
        }
      },
      "map": {
        "rows.id": "TRADE_ID",
        "rows.date": "TRADE_DATE",
        "rows.label": "COUNTERPARTY_NAME",
        "rows.measures": [
          "NOTIONAL",
          "MTM_USD"
        ]
      },
      "controls": {
        "page-size": 25
      }
    },
    "ticket": {
      "use": "entity-card@1",
      "title": "Trade ticket",
      "supply": {
        "connector": "trading/trade"
      },
      "map": {
        "doc.id": "TRADE_ID",
        "doc.title": "DEAL_NUMBER",
        "doc.fields": [
          "INSTRUMENT_TYPE",
          "BUY_SELL",
          "CCY",
          "NOTIONAL",
          "START_DATE",
          "MATURITY_DATE",
          "STATUS"
        ]
      }
    },
    "flows": {
      "use": "cashflow-ladder@1",
      "title": "Cash flows",
      "supply": {
        "model": "trading-risk",
        "query": {
          "measures": [
            "FLOW_AMOUNT"
          ],
          "dimensions": [
            "cashflows.PAY_DATE",
            "cashflows.CCY"
          ]
        }
      },
      "map": {
        "rows.date": "cashflows.PAY_DATE",
        "rows.group": "cashflows.CCY",
        "rows.amount": "FLOW_AMOUNT",
        "rows.trade": "cashflows.TRADE_ID"
      }
    }
  },
  "traces": [
    {
      "from": "trades.selected",
      "to": "ticket.id"
    },
    {
      "from": "trades.selected",
      "to": "flows.filter",
      "transform": {
        "filter-on": "rows.trade"
      }
    },
    {
      "from": "board.params.as-of",
      "to": "trades.date-to"
    }
  ],
  "layout": {
    "theme": "terminal-dark",
    "desktop": {
      "columns": 12,
      "areas": [
        {
          "chip": "trades",
          "at": [
            1,
            1
          ],
          "span": [
            7,
            8
          ]
        },
        {
          "chip": "ticket",
          "at": [
            8,
            1
          ],
          "span": [
            5,
            4
          ]
        },
        {
          "chip": "flows",
          "at": [
            8,
            5
          ],
          "span": [
            5,
            4
          ]
        }
      ]
    },
    "phone": {
      "order": [
        "trades",
        "ticket",
        "flows"
      ],
      "collapsed": [
        "flows"
      ]
    }
  }
}