<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.d</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-dataload</artifactId>
  <name>drishti-dataload</name>
  <description>The data inbox, plain Java (docs/architecture/DATALOAD_INBOX.md): files dropped in a folder with a .ready marker found, claimed, routed, loaded into the lake by the parallel lake loader (drishti-lakeload's LakeLoad, a child Java process with its own heap), recorded in a ledger and moved to the outbox with a report; crash-safe, duplicates skipped, one runner per folder</description>
  <properties>
    <!-- one test JVM: the integration tests start the loader as child Java processes -->
    <drishti.test.forks>1</drishti.test.forks>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <!-- the loader: its exit codes and which files it reads; it runs as a child process from the same class path -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeload</artifactId></dependency>
    <!-- the first line of a .zst file, to know a row form the loader does not read (RowForms) -->
    <dependency><groupId>com.github.luben</groupId><artifactId>zstd-jni</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
