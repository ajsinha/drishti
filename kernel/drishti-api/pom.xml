<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-api</artifactId>
  <name>drishti-api</name>
  <description>Plugin SPI and data model (no Spring)</description>
  <dependencies>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId></dependency>
    <!-- G4: DataNode implements Rachana's Node (SPLIT_PLAN 8.5) -->
    <dependency><groupId>com.ash.rachana</groupId><artifactId>rachana-api</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <!-- Drishti Tools (pure Java): the settings files and the one placeholder resolver, TLS and the outbound proxy, single-flight, the load guard -->
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-settings</artifactId></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-net</artifactId></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-concurrent</artifactId></dependency>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-time</artifactId></dependency>
  </dependencies>
  <properties>
    <!-- HitIndexTest's search budget: its timing execution (the parent's timing-budget-tests) runs here -->
    <drishti.timing.skip>false</drishti.timing.skip>
    <!-- the API reference (the parent's profile api-docs): all of the plugin SPI -->
    <drishti.apidocs.skip>false</drishti.apidocs.skip>
    <drishti.apidocs.packages>com.ash.drishti.api</drishti.apidocs.packages>
  </properties>
</project>
