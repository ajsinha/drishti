<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>${revision}</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-module-runtime</artifactId>
  <name>drishti-module-runtime</name>
  <description>The module runtime (docs/architecture/KERNEL_AND_MODULES.md sections 3, 4, 9.8, 10.4 and 12): the .dmod reader and its hash list, the manifest, verification V1-V8, the conformance checks C1-C14, discovery, the dependency resolver, a class loader and a child Spring context per module, the live route table, the registry of contributions and the unload sequence with its leak check. One implementation, used by the kernel and later by the console host.</description>
  <dependencies>
    <dependency><groupId>com.ash.tools</groupId><artifactId>tools-codec</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-kernel-api</artifactId></dependency>
    <!-- the boot fills drishti-api's plain value of its result (api.resolution.ModuleHomes) for the readers below this module -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
    <!-- a module's server part is a Spring Boot auto-configuration (java.spring of its manifest, e.g. trading's @AutoConfiguration with
         TypeExcludeFilter): the module host, the conformance harness (ModuleCli verify with the conformance option) included, has what the server gives it -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <!-- what the server hosts a module's server part on (its java.spring configuration: Spring Boot's @AutoConfiguration, its Binder, the
         web annotations of its controllers), so the conformance harness loads such a module for C11, C13 and C14 as the server does -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
