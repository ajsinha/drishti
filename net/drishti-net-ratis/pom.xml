<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-net-ratis</artifactId>
  <name>drishti-net-ratis</name>
  <description>The ratis agreement mode (docs/architecture/CLUSTER_I5_DESIGN.md sections 2.3 and 3): leases and the register on an Apache Ratis
    group of three or five voters, mutual TLS required. Ships in lib/ and is loaded only when [net.agreement] mode is ratis; the only module
    that imports org.apache.ratis (ArchitectureRulesTest).</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-net</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <!-- Apache Ratis 3.3.1 (Apache-2.0): the server, the gRPC transport (gRPC, Netty and protobuf shaded in ratis-thirdparty-misc 1.1.0) and
         the client. Netty's native transport and OpenSSL are switched off by RatisAgreement (pure Java on Linux and Windows) -->
    <dependency><groupId>org.apache.ratis</groupId><artifactId>ratis-server</artifactId></dependency>
    <dependency><groupId>org.apache.ratis</groupId><artifactId>ratis-grpc</artifactId></dependency>
    <dependency><groupId>org.apache.ratis</groupId><artifactId>ratis-client</artifactId></dependency>
    <dependency><groupId>org.apache.ratis</groupId><artifactId>ratis-common</artifactId></dependency>
    <dependency><groupId>org.apache.ratis</groupId><artifactId>ratis-proto</artifactId></dependency>
    <dependency><groupId>org.apache.ratis</groupId><artifactId>ratis-server-api</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-net</artifactId><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
