<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-lakeload</artifactId>
  <name>drishti-lakeload</name>
  <description>Loading the lakes (2.9.11.i4: drishti-lakeload with drishti-dataload and drishti-memlake). The parallel lake loader
    (package lakeload): JSON Lines from a folder or S3, parsed, sorted and written as Parquet by many threads, committed as one Delta version
    or one Iceberg overwrite per business date; config-driven, memory bounded, no Hadoop. The data inbox (package dataload,
    docs/architecture/DATALOAD_INBOX.md): files dropped in a folder with a .ready marker found, claimed, routed, loaded by the loader (a child
    Java process with its own heap), recorded in a ledger and moved to the outbox with a report. The in-memory lake (package memlake): the
    mem:// storage (Parquet in off-heap chunks under a hard cap, provided to the lake engines through the lake core's StorageProvider), its
    tables and replenish jobs, eviction, compaction, the owner-node binding, the never-on-disk guard and the host checks. Plain Java (no
    Spring), each package kept to its direction by the architecture rules</description>
  <properties>
    <!-- one test JVM: the loader's tests run its thread pools at full width, one heavy process at a time -->
    <drishti.test.forks>1</drishti.test.forks>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeio</artifactId></dependency>
    <!-- Delta: Delta Kernel's transaction (the commit), as drishti.py lake build's Java writer (LakeWriter) -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-deltalake</artifactId></dependency>
    <!-- Iceberg: the native engine's Parquet writer, catalogs and commits (engine: native, no Hadoop) -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-iceberg</artifactId></dependency>
    <!-- the in-memory lake: the connectors (SourceRegistry) its replenish jobs read, and Delta Kernel for its tables -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-engine</artifactId></dependency>
    <dependency><groupId>io.delta</groupId><artifactId>delta-kernel-api</artifactId><version>${delta-kernel.version}</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>com.github.luben</groupId><artifactId>zstd-jni</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
    <!-- the equality tests: the tables read back through the Delta and Iceberg connectors; the Python path's writers run from this class path -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-delta</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-iceberg</artifactId><scope>test</scope></dependency>
    <!-- S3 source and target on Adobe S3Mock in this JVM -->
    <dependency><groupId>com.adobe.testing</groupId><artifactId>s3mock</artifactId><version>${s3mock.version}</version><scope>test</scope></dependency>
    <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>test</scope></dependency>
    <!-- the in-memory lake's tests: the Storage contract suite (lake core) and the Delta table reader -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeio</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-deltalake</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
  </dependencies>
</project>
