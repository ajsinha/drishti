    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-io</artifactId></dependency>
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-config</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-kernel-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <!-- the loader, the check and the in-memory lake: DrishtiLakeCli starts them with Drishti's runtime -->
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-load</artifactId></dependency>
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-memory</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>com.ash.lake</groupId><artifactId>lake-tck</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
