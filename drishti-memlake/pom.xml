<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.d</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-memlake</artifactId>
  <name>drishti-memlake</name>
  <description>The in-memory lake, plain Java: the mem:// storage (Parquet in off-heap chunks under a hard cap, provided to the lake engines through drishti-lakeio's StorageProvider), the tables and their replenish jobs, eviction, compaction, the owner-node binding, the never-on-disk guard and the host checks</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <!-- the connectors (SourceRegistry): what replenish jobs read, what the guard and the owner binding look at -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-engine</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeio</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeconfig</artifactId></dependency>
    <!-- the lake writer and Delta Kernel: the tables are written, merged, compacted and expired as Delta tables -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-deltalake</artifactId></dependency>
    <dependency><groupId>io.delta</groupId><artifactId>delta-kernel-api</artifactId><version>${delta-kernel.version}</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
    <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>test</scope></dependency>
    <!-- the Storage contract suite (lakeio), the Delta table reader (deltalake) and the Iceberg engine, for the tests only -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeio</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-deltalake</artifactId><version>${project.version}</version><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-iceberg</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
