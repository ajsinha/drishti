<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.g</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-compute</artifactId>
  <name>drishti-compute</name>
  <description>Compute next to the data: out-of-process Python worker pools, Arrow transport, fair scheduling and fan-out, locked environments
    and their approval; the in-memory vector store (row-major double[] chunks, ordinal sets, parallel sums under a memory budget), sharding
    and the reactive connectors. Generic: a domain's maths lives in its own compute module (drishti-compute-banking)</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-kernel-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>org.apache.arrow</groupId><artifactId>arrow-vector</artifactId></dependency>
    <dependency><groupId>org.apache.arrow</groupId><artifactId>arrow-memory-netty</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <!-- BLAS: OpenBLAS bundled for Linux and Windows x86-64 (JavaCPP), else Drishti's own Java kernels (compute.linalg) -->
    <dependency><groupId>org.bytedeco</groupId><artifactId>javacpp</artifactId></dependency>
    <dependency><groupId>org.bytedeco</groupId><artifactId>javacpp</artifactId><classifier>linux-x86_64</classifier></dependency>
    <dependency><groupId>org.bytedeco</groupId><artifactId>javacpp</artifactId><classifier>windows-x86_64</classifier></dependency>
    <dependency><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId></dependency>
    <dependency><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId><classifier>linux-x86_64</classifier></dependency>
    <dependency><groupId>org.bytedeco</groupId><artifactId>openblas</artifactId><classifier>windows-x86_64</classifier></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><scope>test</scope></dependency>
    <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <!-- the worker SDK (pure Python) ships inside the jar; the supervisor extracts it under <data dir>/compute/sdk/<hash>/ -->
      <resource>
        <directory>src/main/python</directory>
        <targetPath>drishti-compute-sdk</targetPath>
        <excludes><exclude>**/__pycache__/**</exclude><exclude>**/*.pyc</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- the load test runs only when asked: -Dgroups=load -Ddrishti.compute.load.workers=32 -->
          <excludedGroups>${compute.excluded.groups}</excludedGroups>
          <systemPropertyVariables>
            <drishti.data.dir>${project.build.directory}/test-run/fork${surefire.forkNumber}/data</drishti.data.dir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <!-- Arrow's memory module reads java.nio.Buffer.address -->
    <argLine>--add-opens=java.base/java.nio=ALL-UNNAMED</argLine>
    <compute.excluded.groups>load</compute.excluded.groups>
    <!-- the API reference (the parent's profile api-docs): the measure-agnostic shard machinery and the peers' fan-out -->
    <drishti.apidocs.skip>false</drishti.apidocs.skip>
    <drishti.apidocs.packages>com.ash.drishti.compute.shard:com.ash.drishti.compute.cluster</drishti.apidocs.packages>
  </properties>
</project>
