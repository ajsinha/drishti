# Copy to config/ai/cohere.yaml (no .example) and set drishti.ai.enabled=true. One file = one provider. OFF until you set enabled: true.
type: cohere
enabled: false
api-key: ${COHERE_API_KEY}                  # COHERE_API_KEY or CO_API_KEY is also read when this line is left out
# embedding-input-type: search_document
timeout: 60s
# tls:                                      # the shared tls.* block of the connectors (docs/connectors/TLS.md): a private CA, mutual TLS, ...
#   ca-file: /etc/drishti/ca.pem
# proxy:                                    # the shared proxy.* block (docs/connectors/PROXY.md); else the site default
#   url: http://proxy.corp:3128
