# Copy to config/ai/ollama.yaml (no .example) and set drishti.ai.enabled=true. One file = one provider. OFF until you set enabled: true.
type: ollama
enabled: false
base-url: http://localhost:11434            # also OLLAMA_HOST; a bare host:port gets http://
# keep-alive: 5m
# num-ctx: 8192
# options:                                  # any Ollama runtime option
#   top_k: 40
timeout: 300s                               # local models can be slow to load
# No api-key: Ollama is local. 'live_models' lists what is pulled (GET /api/tags).
# tls:                                      # the shared tls.* block of the connectors (docs/connectors/TLS.md): a private CA, mutual TLS, ...
#   ca-file: /etc/drishti/ca.pem
# proxy:                                    # the shared proxy.* block (docs/connectors/PROXY.md); else the site default
#   url: http://proxy.corp:3128
