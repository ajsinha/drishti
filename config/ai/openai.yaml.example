# Copy to config/ai/openai.yaml (no .example) and set drishti.ai.enabled=true. One file = one provider.
# Any OpenAI-compatible endpoint: OpenAI, Azure OpenAI, vLLM, Ollama (http://host:11434), LiteLLM, a company gateway.
type: openai
enabled: true
base-url: https://api.openai.com            # no trailing path; Ollama: http://localhost:11434
completions-path: /v1/chat/completions     # Azure: /openai/deployments/<name>/chat/completions?api-version=...
api-key: ${OPENAI_API_KEY}                 # an ${ENV_NAME} placeholder only; a literal key is refused
timeout: 60s
retries: 0                                 # extra attempts after a failure
default-model: fast  # the model a call naming none uses (a logical name of this file)
# header:                                   # extra headers; credentials as ${ENV} (Azure: api-key)
#   api-key: ${AZURE_OPENAI_KEY}
# tls:                                      # the shared tls.* keys, for https:// endpoints with a private CA or mutual TLS
#   ca-file: /etc/drishti/ca.pem
models:
  - name: fast                              # the logical name features use
    id: gpt-4o-mini                         # what the provider calls it
    max-tokens: 400  # the longest answer asked of the model unless a feature asks less
    temperature: 0.2  # the sampling temperature features get unless they ask otherwise
    capabilities: [chat, tool-calls, json-mode]  # what it can do: chat, streaming, tool-calls, embeddings, json-mode; a call needing more is refused
    cost-per-1k-input: 0.00015  # price per 1,000 input tokens (cost limits, audit)
    cost-per-1k-output: 0.0006  # price per 1,000 output tokens
  - name: embed
    id: text-embedding-3-small
    kind: embedding  # chat (the default) or embedding
