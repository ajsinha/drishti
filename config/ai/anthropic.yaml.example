# Copy to config/ai/anthropic.yaml. The Anthropic Messages API.
type: anthropic
base-url: https://api.anthropic.com
api-key: ${ANTHROPIC_API_KEY}
anthropic-version: "2023-06-01"  # the anthropic-version header sent with every call
timeout: 60s
default-model: claude
models:
  - name: claude
    id: claude-sonnet-4-5                   # the provider's model id
    max-tokens: 400
    capabilities: [chat, tool-calls]
