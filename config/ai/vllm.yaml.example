# Copy to config/ai/vllm.yaml (no .example) and set drishti.ai.enabled=true. One file = one provider. OFF until you set enabled: true.
type: vllm
enabled: false
base-url: http://localhost:8000/v1
# api-key: ${VLLM_API_KEY}          # only if the server wants one
timeout: 120s
# live-models: true                         # list what the server serves (GET /models); on by default for the keyless presets
models:                                      # the server's own models are not in the catalogue
  - name: served
    id: the-model-id-the-server-reports
    capabilities: [chat, tool-calls]
  - name: embed
    id: the-embedding-model-id
    kind: embedding
# tls:                                      # the shared tls.* block of the connectors (docs/connectors/TLS.md): a private CA, mutual TLS, ...
#   ca-file: /etc/drishti/ca.pem
# proxy:                                    # the shared proxy.* block (docs/connectors/PROXY.md); else the site default
#   url: http://proxy.corp:3128
