# Copy to config/ai/bedrock.yaml (no .example) and set drishti.ai.enabled=true. One file = one provider. OFF until you set enabled: true.
type: bedrock
enabled: false
region: us-east-1                           # also AWS_REGION / AWS_DEFAULT_REGION
# Credentials: the standard AWS chain (environment, shared profile, SSO, container/instance roles, IRSA) unless you name them:
# profile: my-profile
# aws-access-key-id: ${AWS_ACCESS_KEY_ID}
# aws-secret-access-key: ${AWS_SECRET_ACCESS_KEY}
# aws-session-token: ${AWS_SESSION_TOKEN}
# base-url: https://vpce-....bedrock-runtime.us-east-1.vpce.amazonaws.com   # an endpoint override
# embedding-input-type: search_document     # Cohere embedding models
timeout: 60s
retries: 1
# tls:                                      # the shared tls.* block of the connectors (docs/connectors/TLS.md): a private CA, mutual TLS, ...
#   ca-file: /etc/drishti/ca.pem
# proxy:                                    # the shared proxy.* block (docs/connectors/PROXY.md); else the site default
#   url: http://proxy.corp:3128
