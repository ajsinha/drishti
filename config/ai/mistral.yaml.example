# Copy to config/ai/mistral.yaml (no .example) and set drishti.ai.enabled=true. One file = one provider. OFF until you set enabled: true.
type: mistral
enabled: false
# base-url: https://api.mistral.ai/v1   # the vendor's address is the default
api-key: ${MISTRAL_API_KEY}                  # an ${ENV_NAME} placeholder only; a literal key is refused (MISTRAL_API_KEY is also read when this line is left out)
timeout: 60s
retries: 1
# default-model: ...                        # a catalogue model; the catalogue (ai/llm_catalog.json) is listed unless 'catalogue: false'
# models:                                   # add to or override the catalogue (a new vendor model id needs no code change)
#   - name: my-model
#     id: vendor/model-id
#     capabilities: [chat, tool-calls, json-mode]
#     cost-per-1k-input: 0.0006
#     cost-per-1k-output: 0.0024
# tls:                                      # the shared tls.* block of the connectors (docs/connectors/TLS.md): a private CA, mutual TLS, ...
#   ca-file: /etc/drishti/ca.pem
# proxy:                                    # the shared proxy.* block (docs/connectors/PROXY.md); else the site default
#   url: http://proxy.corp:3128
