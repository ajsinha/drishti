     "scaleTo": "$.legs.1.pv",
     "places": 2
    },
    {
     "set": "valuation.npv",
     "expr": "$.mtm"
    },
    {
     "set": "valuation.cleanPv",
     "expr": "$.mtm - valuation.accrued"
    },
    {
     "set": "pnl1d",
     "expr": "$.mtm - pnlExplain.0.pnl"
    },
    {
     "set": "pnlExplain.3.pnl",
     "expr": "pnlExplain.3.pnl + ($.mtm - sum(pnlExplain.*.pnl))"
    }
   ]
  }
 }
}
