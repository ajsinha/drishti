<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11.d</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-bicompute</artifactId>
  <name>drishti-bicompute</name>
  <description>The pivot engine (docs/architecture/PIVOT_ENGINE.md): plain Java, no Spring. The pivot model (views, cell keys, nested
    expandable axes), the provider SPI and the aggregation-function SPI (start, add, merge, finish; mergeable, sketch, holistic), the
    built-in functions, partial states merged in a fixed order, the partial-state cache, the GROUPING SETS compiler and the DuckDB tabular
    provider, and the exports (xlsx with outline levels and formulas only where a measure adds up, CSV). Every component that aggregates
    calls this module; none re-implements aggregation.</description>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-common</artifactId></dependency>
    <!-- Rachana's grammar (docs/architecture/ARCHITECTURE.md): the engine registers every aggregate into its function table (one direction only:
         Rachana never depends on the engine). Rachana's Spring wiring stays out of the engine; the tests that load Sutras add it. -->
    <dependency>
      <groupId>com.ash.drishti</groupId><artifactId>drishti-rachana</artifactId>
      <exclusions>
        <exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId></exclusion>
        <exclusion><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.github.ben-manes.caffeine</groupId><artifactId>caffeine</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.duckdb</groupId><artifactId>duckdb_jdbc</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>ch.qos.logback</groupId><artifactId>logback-classic</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
