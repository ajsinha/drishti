<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.6</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-lakeload</artifactId>
  <name>drishti-lakeload</name>
  <description>The parallel lake loader (2.9.6): JSON Lines from a folder or S3, parsed, sorted and written as Parquet by many threads, committed as one Delta version or one Iceberg overwrite per business date; config-driven, memory bounded, no Hadoop</description>
  <properties>
    <!-- one test JVM: the loader's tests run its thread pools at full width, one heavy process at a time -->
    <drishti.test.forks>1</drishti.test.forks>
  </properties>
  <dependencies>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-lakeio</artifactId></dependency>
    <!-- Delta: Delta Kernel's transaction (the commit), as drishti.py lake build's Java writer (LakeWriter) -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-deltalake</artifactId></dependency>
    <!-- Iceberg: the native engine's Parquet writer, catalogs and commits (engine: native, no Hadoop) -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-iceberg</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
    <dependency><groupId>com.github.luben</groupId><artifactId>zstd-jni</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-testkit</artifactId><scope>test</scope></dependency>
    <!-- the equality tests: the tables read back through the Delta and Iceberg connectors; the Python path's writers run from this class path -->
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-delta</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.ash.drishti</groupId><artifactId>drishti-plugin-iceberg</artifactId><scope>test</scope></dependency>
    <!-- S3 source and target on Adobe S3Mock in this JVM -->
    <dependency><groupId>com.adobe.testing</groupId><artifactId>s3mock</artifactId><version>${s3mock.version}</version><scope>test</scope></dependency>
  </dependencies>
</project>
