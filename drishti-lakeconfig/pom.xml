<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ash.drishti</groupId>
    <artifactId>drishti-parent</artifactId>
    <version>2.9.11</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>drishti-lakeconfig</artifactId>
  <name>drishti-lakeconfig</name>
  <description>The lake configuration (config/lakes/*.yaml): one description of each lake and every table in it, read by the writers (the loader, the data inbox, lake build, the demo lakes) and the readers (the Delta and Iceberg connectors) alike. Plain Java and Jackson only, so every module, a plugin included, can depend on it</description>
  <dependencies>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId></dependency>
  </dependencies>
</project>
