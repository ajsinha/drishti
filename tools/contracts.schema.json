{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drishti.local/schemas/data-contract.schema.json",
  "title": "Drishti data contract of one command (mnemonic) kind",
  "description": "modules/<module>/packs/<pack>/contracts/<kind>.contract.yaml. Conventions: docs/contracts/README.md; the format: its section 16. Checked by tools/contracts.py (drishti.py contract check).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "mnemonic", "pack", "version", "class", "status", "title", "description", "source", "grain", "key",
               "dated-by", "cadence", "binding-hint", "fields", "validation", "review"],
  "properties": {
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "mnemonic": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
    "pack": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "class": {"enum": ["fundamental", "input", "drishti-owned", "computed"]},
    "status": {"enum": ["active", "retiring", "planned"]},
    "retiring-in": {"$ref": "#/$defs/release"},
    "replaced-by": {"type": "string", "pattern": "^docs/contracts/[A-Z_]+\\.md$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "grain": {"type": "string", "minLength": 1},
    "key": {"type": "array", "items": {"type": "string"}},
    "id-pattern": {"type": "array", "items": {"type": "string"}},
    "dated-by": {"type": "string", "pattern": "^([A-Za-z_][A-Za-z0-9_]*|snapshot|on request)$"},
    "cadence": {
      "type": "object", "additionalProperties": false, "required": ["frequency", "due"],
      "properties": {
        "frequency": {"enum": ["daily", "intraday", "static", "on change"]},
        "due": {"type": "string"}
      }
    },
    "list": {
      "description": "How the kind may be listed: requires names the fields one of which must narrow a list (a vector-heavy input is never listed whole).",
      "type": "object", "additionalProperties": false, "required": ["requires"],
      "properties": {"requires": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_.]*$"}},
                     "why": {"type": "string"}}
    },
    "binding-hint": {
      "description": "What a site usually binds (docs/architecture/KERNEL_AND_MODULES.md section 5.2): never a connector, a plugin or a location.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "lake-table": {"type": "string", "pattern": "^[a-z0-9_-]+\\.[a-z0-9_.-]+$"},
        "partition": {"type": "array", "items": {"type": "string"}},
        "computed": {"type": "boolean"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "vectors": {"type": "array", "items": {"type": "string"}},
        "test-data": {"type": "array", "items": {"type": "string"}}
      }
    },
    "live": {
      "description": "What a live message means for the kind (docs/architecture/LIVE_CONNECTORS_DESIGN.md section 2.3): the companion connector holds the transport only. Absent: arrival order, whole rows, overlay, reset at the next load, strict.",
      "type": "object", "additionalProperties": false,
      "properties": {
        "allowed": {"type": "boolean"},
        "order": {"type": "array", "items": {"type": "string"}},
        "changed-at": {"type": "string"},
        "changed-by": {"type": "string"},
        "as-of": {"type": "string"},
        "partial": {"enum": ["whole", "merge"]},
        "delete": {"type": "object", "additionalProperties": false, "properties": {"when": {"type": ["string", "null"]}}},
        "apply": {"enum": ["overlay", "land"]},
        "conflate": {"type": "string", "pattern": "^(none|[0-9]+(ms|s|m|h|d))$"},
        "absorb": {"enum": ["by-order", "by-cutoff", "reset"]},
        "retention": {"type": "object", "additionalProperties": false,
                      "properties": {"ttl": {"$ref": "#/$defs/duration"}, "max-rows": {"type": "integer", "minimum": 1}}},
        "validate": {"enum": ["strict", "lenient", "deferred"]},
        "effective": {"enum": ["at-once", "next-load"]},
        "closed-dates": {"enum": ["reject", "restate"]},
        "keep-versions": {"type": "integer", "minimum": 1},
        "reorder-window": {"$ref": "#/$defs/duration"},
        "max-message-kb": {"type": "integer", "minimum": 1},
        "land-key": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "nested": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*$"},
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/field"}}
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["field", "kind"],
        "properties": {"field": {"type": "string"}, "kind": {"type": "string"}}
      }
    },
    "validation": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "retiring"}}}, "then": {"required": ["retiring-in", "replaced-by"]}}
  ],
  "$defs": {
    "duration": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h|d)$"},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+( or [0-9]+\\.[0-9]+\\.[0-9]+)?$"},
    "field": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "presence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "type": {"enum": ["text", "id", "integer", "amount", "rate", "date", "timestamp", "boolean", "vector", "record",
                          "record list", "text list", "id list", "date list", "list", "unknown"]},
        "presence": {"enum": ["required", "optional", "derived"]},
        "unit": {"type": "string"},
        "description": {"type": "string"},
        "example": {"type": ["string", "number", "boolean"]},
        "enum": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
        "pattern": {"type": "string"},
        "link": {"type": "string"},
        "retiring-in": {"$ref": "#/$defs/release"},
        "note": {"type": "string"}
      }
    },
    "rule": {
      "type": "object", "required": ["rule"],
      "properties": {
        "rule": {"enum": ["required", "unique", "enum", "pattern", "link", "range", "vector-length", "type"]}
      },
      "allOf": [
        {"if": {"properties": {"rule": {"const": "required"}}}, "then": {"required": ["fields"]}},
        {"if": {"properties": {"rule": {"const": "unique"}}}, "then": {"required": ["key", "per"]}},
        {"if": {"properties": {"rule": {"const": "enum"}}}, "then": {"required": ["field", "values"]}},
        {"if": {"properties": {"rule": {"const": "pattern"}}}, "then": {"required": ["field", "pattern"]}},
        {"if": {"properties": {"rule": {"const": "link"}}}, "then": {"required": ["field", "kind"]}},
        {"if": {"properties": {"rule": {"const": "range"}}}, "then": {"required": ["field"]}},
        {"if": {"properties": {"rule": {"const": "vector-length"}}}, "then": {"required": ["field"]}}
      ]
    }
  }
}
