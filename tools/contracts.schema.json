{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drishti.local/schemas/data-contract.schema.json",
  "title": "Drishti data contract of one command (mnemonic) kind",
  "description": "config/packs/<pack>/contracts/<kind>.contract.yaml. Conventions: docs/contracts/README.md; the format: its section 16. Checked by tools/contracts.py (drishti.py contract check).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "mnemonic", "pack", "version", "class", "status", "title", "description", "source", "grain", "key",
               "dated-by", "cadence", "storage", "fields", "validation", "review"],
  "properties": {
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "mnemonic": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*$"},
    "pack": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "class": {"enum": ["fundamental", "input", "drishti-owned", "computed"]},
    "status": {"enum": ["active", "retiring"]},
    "retiring-in": {"$ref": "#/$defs/release"},
    "replaced-by": {"type": "string", "pattern": "^docs/contracts/[A-Z_]+\\.md$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "grain": {"type": "string", "minLength": 1},
    "key": {"type": "array", "items": {"type": "string"}},
    "id-pattern": {"type": "array", "items": {"type": "string"}},
    "dated-by": {"type": "string", "pattern": "^([A-Za-z_][A-Za-z0-9_]*|snapshot|on request)$"},
    "cadence": {
      "type": "object", "additionalProperties": false, "required": ["frequency", "due"],
      "properties": {
        "frequency": {"enum": ["daily", "intraday", "static", "on change"]},
        "due": {"type": "string"}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false, "required": ["connector", "plugin"],
      "properties": {
        "connector": {"type": "string"},
        "plugin": {"type": "string"},
        "domain": {"type": "string"},
        "table": {"type": "string"},
        "columns": {"type": "array", "items": {"type": "string"}},
        "vectors": {"type": "array", "items": {"type": "string"}},
        "partition-by": {"type": "array", "items": {"type": "string"}},
        "test-data": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
    "nested": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*$"},
      "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/field"}}
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["field", "kind"],
        "properties": {"field": {"type": "string"}, "kind": {"type": "string"}}
      }
    },
    "validation": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "review": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "retiring"}}}, "then": {"required": ["retiring-in", "replaced-by"]}}
  ],
  "$defs": {
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+( or [0-9]+\\.[0-9]+\\.[0-9]+)?$"},
    "field": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "presence"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "type": {"enum": ["text", "id", "integer", "amount", "rate", "date", "timestamp", "boolean", "vector", "record",
                          "record list", "text list", "id list", "date list", "list", "unknown"]},
        "presence": {"enum": ["required", "optional", "derived"]},
        "unit": {"type": "string"},
        "description": {"type": "string"},
        "example": {"type": ["string", "number", "boolean"]},
        "enum": {"type": "array", "items": {"type": ["string", "number", "boolean"]}},
        "pattern": {"type": "string"},
        "link": {"type": "string"},
        "retiring-in": {"$ref": "#/$defs/release"},
        "note": {"type": "string"}
      }
    },
    "rule": {
      "type": "object", "required": ["rule"],
      "properties": {
        "rule": {"enum": ["required", "unique", "enum", "pattern", "link", "range", "vector-length", "type"]}
      },
      "allOf": [
        {"if": {"properties": {"rule": {"const": "required"}}}, "then": {"required": ["fields"]}},
        {"if": {"properties": {"rule": {"const": "unique"}}}, "then": {"required": ["key", "per"]}},
        {"if": {"properties": {"rule": {"const": "enum"}}}, "then": {"required": ["field", "values"]}},
        {"if": {"properties": {"rule": {"const": "pattern"}}}, "then": {"required": ["field", "pattern"]}},
        {"if": {"properties": {"rule": {"const": "link"}}}, "then": {"required": ["field", "kind"]}},
        {"if": {"properties": {"rule": {"const": "range"}}}, "then": {"required": ["field"]}},
        {"if": {"properties": {"rule": {"const": "vector-length"}}}, "then": {"required": ["field"]}}
      ]
    }
  }
}
